---
// Google "Add to preferred sources" button, placed at the top of a story.
// The library script in BaseLayout.astro scans the page for the attribute,
// so this component only renders the container. The wrapper reserves height
// so nothing shifts when the button appears. If the site is not listed in
// Google's source preferences tool the button renders nothing.
export interface Props {
  theme?: 'light' | 'dark';
  inline?: boolean; // sits in a row with another element, no outer margin
}
const { theme = 'light', inline = false } = Astro.props;
---
<div class:list={['pref-source', { 'pref-source--inline': inline }]} aria-label="Add Long Press as a preferred source on Google">
  <div google-add-preferred-source-btn data-theme={theme} data-lang="en"></div>
</div>

<style>
  .pref-source { min-height: 44px; margin: 14px 0 6px; }
  .pref-source--inline { margin: 0; flex: 0 0 auto; }
</style>
