---
/**
 * "Previously on Long Press": up to three links to earlier coverage of the
 * same thing. Links only, never copied text, so the full text still lives in
 * exactly one place. Renders nothing when there is nothing worth linking.
 */
import { relatedFor } from '../lib/related';

interface Props {
  /** `daily:2026-10-07#3` for a brief item, `story:<slug>` for a story. */
  id: string;
}
const { id } = Astro.props;
const links = await relatedFor(id);
const domId = `previously-${id.replace(/[^a-z0-9]+/gi, '-').replace(/-+$/, '')}`;
const fmt = new Intl.DateTimeFormat('en-IN', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
---

{links.length > 0 && (
  <aside class="previously" aria-labelledby={domId}>
    <h3 class="previously__title" id={domId}>Previously on Long Press</h3>
    <ul class="previously__list">
      {links.map((l) => (
        <li>
          <a href={l.href}>{l.title}</a>
          <span class="previously__meta">
            <span class={`previously__tag${l.isColumn ? ' previously__tag--column' : ''}`}>{l.tag}</span>
            <time datetime={l.date.toISOString().slice(0, 10)}>{fmt.format(l.date)}</time>
          </span>
        </li>
      ))}
    </ul>
  </aside>
)}

<style>
  .previously {
    margin-top: var(--s5);
    padding-top: var(--s3);
    border-top: 2px solid var(--rule-strong);
  }
  .previously__title {
    margin: 0 0 var(--s1);
    font-family: var(--display);
    font-variation-settings: var(--display-normal);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .previously__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .previously__list li {
    display: grid;
    gap: 2px;
    padding: var(--s3) 0;
    border-bottom: 1px solid var(--rule);
  }
  .previously__list a {
    font-family: var(--display);
    font-variation-settings: var(--display-normal);
    font-weight: 600;
    font-size: 1.02rem;
    line-height: 1.3;
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
    overflow-wrap: anywhere;
  }
  .previously__list a:hover {
    color: var(--accent-deep);
  }
  .previously__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s2);
    font-family: var(--mono);
    font-size: 0.74rem;
    letter-spacing: 0.04em;
    color: var(--muted);
  }
  .previously__tag {
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-size: 0.68rem;
  }
  .previously__tag--column {
    color: var(--accent-2);
  }
</style>
