  /* --- Theme Mode Card --------------------------------------- */
  .drawer-theme-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 14px;
    min-height: 48px;
    background: var(--ground);
    border: 1.5px solid var(--rule);
    box-sizing: border-box;
  }

  .drawer-theme-card__info {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .drawer-theme-card__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    background: var(--surface);
    border: 1px solid var(--rule);
    color: var(--accent-deep);
    flex-shrink: 0;
  }

  .drawer-theme-svg--sun { display: none; }
  .drawer-theme-svg--moon { display: block; }

  :global(html[data-theme="dark"]) .drawer-theme-svg--sun { display: block; color: #FFA07E; }
  :global(html[data-theme="dark"]) .drawer-theme-svg--moon { display: none; }

  .drawer-theme-card__text {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .drawer-theme-card__title {
    font-family: var(--display);
