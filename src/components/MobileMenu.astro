    padding: 6px 14px;
    border: 1.5px solid var(--rule-strong);
    background: var(--surface);
    color: var(--ink);
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.16s ease;
    white-space: nowrap;
  }

  .drawer-theme-toggle-btn:hover {
