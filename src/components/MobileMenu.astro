  /* --- Discovery & Utility List ------------------------------ */
  .drawer-utility-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .drawer-utility-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 12px;
    min-height: 48px;
    background: transparent;
    border: 1px solid transparent;
