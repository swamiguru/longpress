  }

  .drawer-utility-item:hover .drawer-utility-item__icon {
    color: var(--accent-deep);
    border-color: var(--rule-strong);
  }

  .drawer-utility-item__icon--rss {
    color: var(--accent-deep);
  }

  .drawer-utility-item__text {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .drawer-utility-item__title {
    font-family: var(--display);
    font-size: 13.5px;
    font-weight: 700;
    color: var(--ink);
    line-height: 1.25;
  }

  .drawer-utility-item__sub {
    font-size: 11.5px;
    color: var(--muted);
    line-height: 1.3;
  }

  .drawer-utility-item__hint {
    font-family: var(--mono);
