---
/**
 * Scroll-based reading progress bar fixed at the top of the viewport.
 * Tracks reader progress through the article content smoothly.
 */
---
<div
  id="reading-progress-container"
  class="reading-progress"
  role="progressbar"
  aria-label="Reading progress"
  aria-valuemin="0"
  aria-valuemax="100"
  aria-valuenow="0"
>
  <div id="reading-progress-bar" class="reading-progress__bar"></div>
</div>

<style>
  .reading-progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    width: 100%;
    height: 3px;
    background: transparent;
    z-index: 9999;
    pointer-events: none;
  }

  .reading-progress__bar {
    width: 100%;
    height: 100%;
    background-color: var(--accent, #E0552B);
    transform-origin: 0 50%;
    transform: scaleX(0);
    will-change: transform;
    transition: transform 60ms linear;
  }

  @media (prefers-reduced-motion: reduce) {
    .reading-progress__bar {
      transition: none;
    }
  }
</style>

<script>
  function initReadingProgress() {
    const container = document.getElementById('reading-progress-container');
    const bar = document.getElementById('reading-progress-bar');
    if (!container || !bar) return;

    let ticking = false;

    function calculateProgress(): number {
      const article = document.querySelector('article');
      const scrollY = window.scrollY || window.pageYOffset || 0;
      const viewportHeight = window.innerHeight;

      if (article) {
        const rect = article.getBoundingClientRect();
        const articleTop = rect.top + scrollY;
        const articleHeight = article.offsetHeight;
        
        // Progress starts when top of article is encountered
        // Reaches 100% when reader finishes the article content
        const scrollDistance = articleHeight - viewportHeight * 0.75;
        if (scrollDistance <= 0) {
          const docScroll = document.documentElement.scrollHeight - viewportHeight;
          return docScroll > 0 ? scrollY / docScroll : 1;
        }

        const scrolled = scrollY - articleTop;
        const ratio = scrolled / scrollDistance;
        return Math.min(1, Math.max(0, ratio));
      }

      // Fallback to whole page scroll
      const docHeight = document.documentElement.scrollHeight - viewportHeight;
      if (docHeight <= 0) return 0;
      return Math.min(1, Math.max(0, scrollY / docHeight));
    }

    function update() {
      const progress = calculateProgress();
      bar.style.transform = `scaleX(${progress})`;
      const percent = Math.round(progress * 100);
      container.setAttribute('aria-valuenow', percent.toString());
      ticking = false;
    }

    function onScroll() {
      if (!ticking) {
        window.requestAnimationFrame(update);
        ticking = true;
      }
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    update();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initReadingProgress);
  } else {
    initReadingProgress();
  }

  document.addEventListener('astro:page-load', initReadingProgress);
</script>
