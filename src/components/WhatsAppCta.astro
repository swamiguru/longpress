---
// WhatsAppCta.astro: one component, five placements.
//   header  compact pill in the masthead (icon only below 1041px)
//   strip   slim one-line bar: top of a brief, homepage, mobile drawer
//   card    the closing ask, after the reader has finished the five
//   footer  button in the footer brand column
// `location` is sent to GTM as cta_location on click (see BaseLayout.astro),
// so each placement can be compared in GA4.
import { WHATSAPP_CHANNEL_URL, WHATSAPP_ICON_PATH } from '../lib/channels.mjs';

export interface Props {
  variant?: 'header' | 'strip' | 'card' | 'footer';
  location: string;
  heading?: string;
  text?: string;
}
const { variant = 'strip', location, heading, text } = Astro.props;

const COPY = {
  strip: {
    heading: 'The Daily Five on WhatsApp',
    text: 'Follow the Long Press channel.',
  },
  card: {
    heading: 'Get tomorrow\u2019s five on WhatsApp',
    text: 'Follow the Long Press channel and the next brief is waiting when you open WhatsApp.',
  },
};
const copy = {
  heading: heading ?? COPY[variant === 'card' ? 'card' : 'strip'].heading,
  text: text ?? COPY[variant === 'card' ? 'card' : 'strip'].text,
};
const attrs = {
  href: WHATSAPP_CHANNEL_URL,
  target: '_blank',
  rel: 'noopener',
  'data-wa-cta': location,
};
const ICON = WHATSAPP_ICON_PATH;
---

{variant === 'header' && (
  <a {...attrs} class="wa-header" aria-label="Follow Long Press on WhatsApp">
    <svg class="wa-icon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d={ICON} fill="currentColor" /></svg>
    <span class="wa-header__label">WhatsApp</span>
  </a>
)}

{variant === 'strip' && (
  <aside class="wa-strip" aria-label="Long Press on WhatsApp">
    <svg class="wa-icon wa-strip__icon" viewBox="0 0 24 24" width="26" height="26" aria-hidden="true"><path d={ICON} fill="currentColor" /></svg>
    <p class="wa-strip__text"><strong>{copy.heading}</strong> <span>{copy.text}</span></p>
    <a {...attrs} class="wa-btn wa-btn--sm">Follow <span aria-hidden="true">&rarr;</span></a>
  </aside>
)}

{variant === 'card' && (
  <aside class="wa-card" aria-label="Long Press on WhatsApp">
    <svg class="wa-icon wa-card__icon" viewBox="0 0 24 24" width="40" height="40" aria-hidden="true"><path d={ICON} fill="currentColor" /></svg>
    <div class="wa-card__body">
      <h3 class="wa-card__heading">{copy.heading}</h3>
      <p class="wa-card__text">{copy.text}</p>
    </div>
    <a {...attrs} class="wa-btn">Follow on WhatsApp <span aria-hidden="true">&rarr;</span></a>
  </aside>
)}

{variant === 'footer' && (
  <a {...attrs} class="wa-btn wa-btn--footer">
    <svg class="wa-icon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d={ICON} fill="currentColor" /></svg>
    Follow on WhatsApp
  </a>
)}
