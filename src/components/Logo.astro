---
export interface Props {
  variant?: 'masthead' | 'compact' | 'footer';
  showTagline?: boolean;
}

const { variant = 'masthead', showTagline = false } = Astro.props;
---
<div class={`brand-logo brand-logo--${variant}`} id="brand-logo">
  <div class="brand-logo__mark" aria-hidden="true">
    <!-- Press and hold: the ring fills while you wait. 135deg arc. -->
    <svg width="38" height="38" viewBox="0 0 42 42" fill="none" xmlns="http://www.w3.org/2000/svg">
      <circle cx="21" cy="21" r="19.5" fill="none" class="mark-ring" stroke-width="2" />
      <path d="M21 1.5a19.5 19.5 0 0 1 13.8 33.3" fill="none" stroke="#E0552B" stroke-width="4.5" stroke-linecap="round" />
      <circle cx="21" cy="21" r="7.5" class="mark-dot" />
    </svg>
  </div>
  <div class="brand-logo__text">
    <span class="brand-logo__title">Long<span class="word-press">press</span></span>
    {showTagline && (
      <span class="brand-logo__tagline">Press and hold &middot; the tech signal</span>
    )}
  </div>
</div>

<style>
  .brand-logo {
    display: inline-flex;
    align-items: center;
    gap: 13px;
    text-decoration: none;
    color: var(--ink);
    user-select: none;
  }

  .brand-logo__mark {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: transform .2s cubic-bezier(.2, .8, .2, 1);
  }
  .brand-logo:hover .brand-logo__mark { transform: scale(1.05); }

  .mark-ring { stroke: var(--ink); }
  .mark-dot  { fill: var(--ink); }

  .brand-logo__text {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    line-height: 1;
  }

  .brand-logo__title {
    font-family: var(--display);
    font-variation-settings: var(--display-wide);
    font-weight: 800;
    font-size: 26px;
    line-height: .9;
    letter-spacing: -0.04em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .word-press { color: var(--accent); }

  .brand-logo__tagline {
    font-family: var(--mono);
    font-size: 8.5px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
  }

  /* Compact — sticky nav, mobile. Tagline is dropped by the caller. */
  .brand-logo--compact { gap: 10px; }
  .brand-logo--compact .brand-logo__title { font-size: 19px; }
  .brand-logo--compact .brand-logo__mark svg { width: 30px; height: 30px; }

  /* Footer — reverse, stacked */
  .brand-logo--footer { flex-direction: column; align-items: flex-start; gap: 11px; }
  .brand-logo--footer .brand-logo__title { font-size: 21px; color: var(--dark-ink); }
  .brand-logo--footer .mark-ring { stroke: var(--dark-ink); }
  .brand-logo--footer .mark-dot  { fill: var(--dark-ink); }
  .brand-logo--footer .brand-logo__mark svg { width: 30px; height: 30px; }
</style>
