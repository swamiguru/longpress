---
export interface Props {
  variant?: 'masthead' | 'compact' | 'footer';
  showTagline?: boolean;
}

const { variant = 'masthead', showTagline = false } = Astro.props;
---
<div class={`brand-logo brand-logo--${variant}`} id="brand-logo">
  <div class="brand-logo__mark" aria-hidden="true">
    <!-- Press and hold: the ring fills while you wait. 135deg arc from 12 o'clock.
         The arc is a circle with pathLength=360 so dash lengths read as degrees
         and the masthead animation can grow it. Static render matches the old path. -->
    <svg width="38" height="38" viewBox="0 0 42 42" fill="none" xmlns="http://www.w3.org/2000/svg">
      <circle cx="21" cy="21" r="19.5" fill="none" class="mark-ripple" stroke="#E0552B" stroke-width="1.5" />
      <circle cx="21" cy="21" r="19.5" fill="none" class="mark-ring" stroke-width="2" />
      <circle cx="21" cy="21" r="19.5" fill="none" class="mark-arc" stroke="#E0552B" stroke-width="4.5" stroke-linecap="round" pathLength="360" stroke-dasharray="135 360" transform="rotate(-90 21 21)" />
      <circle cx="21" cy="21" r="7.5" class="mark-dot" />
    </svg>
  </div>
  <div class="brand-logo__text">
    <span class="brand-logo__title">Long<span class="word-press">press</span></span>
    {showTagline && (
      <span class="brand-logo__tagline">Press and hold &middot; the tech signal</span>
    )}
  </div>
</div>

<style>
  .brand-logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--ink);
    user-select: none;
  }

  .brand-logo__mark {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: transform .2s cubic-bezier(.2, .8, .2, 1);
  }
  .brand-logo__mark svg {
    width: 32px;
    height: 32px;
  }
  .brand-logo:hover .brand-logo__mark { transform: scale(1.05); }

  .mark-ring { stroke: var(--ink); }
  .mark-dot  { fill: var(--ink); }

  .brand-logo__text {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    line-height: 1;
  }

  .brand-logo__title {
    font-family: var(--display);
    font-variation-settings: var(--display-wide);
    font-weight: 800;
    font-size: 22px;
    line-height: .9;
    letter-spacing: -0.04em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .word-press { color: var(--accent); }

  /* Masthead — primary header branding */
  .brand-logo--masthead {
    gap: 12px;
  }
  .brand-logo--masthead .brand-logo__mark svg {
    width: 36px;
    height: 36px;
  }
  .brand-logo--masthead .brand-logo__title {
    font-size: 24px;
    letter-spacing: -0.035em;
  }
  .brand-logo--masthead .brand-logo__tagline {
    font-size: 9px;
    letter-spacing: 0.14em;
  }

  .brand-logo__tagline {
    font-family: var(--mono);
    font-size: 8px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }

  /* Compact — sticky nav, mobile. Tagline is dropped by the caller. */
  .brand-logo--compact { gap: 8px; }
  .brand-logo--compact .brand-logo__title { font-size: 18px; }
  .brand-logo--compact .brand-logo__mark svg { width: 24px; height: 24px; }

  /* Footer — horizontal, sleek and compact */
  .brand-logo--footer {
    display: inline-flex;
    flex-direction: row;
    align-items: center;
    gap: 9px;
  }
  .brand-logo--footer .brand-logo__title {
    font-size: 18px;
    color: var(--dark-ink);
  }
  .brand-logo--footer .mark-ring { stroke: var(--dark-ink); }
  .brand-logo--footer .mark-dot  { fill: var(--dark-ink); }
  .brand-logo--footer .brand-logo__mark svg { width: 22px; height: 22px; }

  /* Press-and-hold animation: masthead mark only. Plays twice shortly after
     load, then rests; replays on hover or tap (see script). JS adds
     .is-playing and removes it on animationend, so it never loops. */
  .mark-ripple { opacity: 0; }
  .mark-dot, .mark-ripple { transform-box: fill-box; transform-origin: center; }

  .brand-logo--masthead.is-playing .mark-dot    { animation: lp-dot 3.6s var(--lp-count, 1) both; }
  .brand-logo--masthead.is-playing .mark-arc    { animation: lp-arc 3.6s var(--lp-count, 1) both; }
  .brand-logo--masthead.is-playing .mark-ripple { animation: lp-ripple 3.6s var(--lp-count, 1) both; }

  @keyframes lp-dot {
    0%, 6%   { transform: scale(1); }
    16%, 52% { transform: scale(.84); }
    60%      { transform: scale(1.07); }
    68%, 100% { transform: scale(1); }
  }
  @keyframes lp-arc {
    0%, 6%    { stroke-dasharray: 135 360; }
    52%       { stroke-dasharray: 190 360; }
    62%, 100% { stroke-dasharray: 135 360; }
  }
  @keyframes lp-ripple {
    0%, 52% { opacity: 0; transform: scale(.35); }
    54%     { opacity: .4; transform: scale(.35); }
    72%, 100% { opacity: 0; transform: scale(1); }
  }

  @media (prefers-reduced-motion: reduce) {
    .brand-logo--masthead.is-playing .mark-dot,
    .brand-logo--masthead.is-playing .mark-arc,
    .brand-logo--masthead.is-playing .mark-ripple { animation: none; }
  }
</style>

<script>
  const logo = document.querySelector<HTMLElement>('.brand-logo--masthead');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (logo && !reduce) {
    const dot = logo.querySelector('.mark-dot');
    let playing = false;

    const play = (count: number) => {
      if (playing) return;
      playing = true;
      logo.style.setProperty('--lp-count', String(count));
      logo.classList.add('is-playing');
    };

    dot?.addEventListener('animationend', () => {
      logo.classList.remove('is-playing');
      playing = false;
    });

    // Twice on load, after the page has settled. Hover or tap replays once.
    window.setTimeout(() => play(2), 800);
    logo.addEventListener('pointerenter', () => play(1));
  }
</script>
