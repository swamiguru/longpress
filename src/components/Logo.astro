---
export interface Props {
  variant?: 'masthead' | 'compact' | 'footer';
  showTagline?: boolean;
}

const { variant = 'masthead', showTagline = false } = Astro.props;
---
<div class={`brand-logo brand-logo--${variant}`} id="brand-logo">
  <div class="brand-logo__mark" aria-hidden="true">
    <!-- Press and hold: the arc fills while you wait. SCREEN icon: slate tile,
         amber ring, terracotta arc, amber dot. The arc is a circle with
         pathLength=360 so dash lengths read as degrees. Static render is 180deg. -->
    <svg width="38" height="38" viewBox="0 0 44 44" fill="none" xmlns="http://www.w3.org/2000/svg">
      <rect x="2" y="2" width="40" height="40" rx="11" class="mark-tile" />
      <circle cx="22" cy="22" r="10" fill="none" class="mark-ring" stroke-width="2.8" />
      <circle cx="22" cy="22" r="10" fill="none" class="mark-arc" stroke-width="2.8" stroke-linecap="butt" pathLength="360" stroke-dasharray="180 360" transform="rotate(-90 22 22)" />
      <circle cx="22" cy="22" r="3.6" class="mark-dot" />
    </svg>
  </div>
  <div class="brand-logo__text">
    <span class="brand-logo__title">Long&nbsp;<span class="word-press">Press</span><span class="brand-logo__cursor" aria-hidden="true"></span></span>
    {showTagline && (
      <span class="brand-logo__tagline">Press and hold &middot; the tech signal</span>
    )}
  </div>
</div>

<style>
  .brand-logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--ink);
    user-select: none;
  }

  .brand-logo__mark {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: transform .2s cubic-bezier(.2, .8, .2, 1);
  }
  .brand-logo__mark svg {
    width: 32px;
    height: 32px;
  }
  .brand-logo:hover .brand-logo__mark { transform: scale(1.05); }

  .mark-tile { fill: #34323F; }
  .mark-ring { stroke: #E3C58A; }
  .mark-arc  { stroke: #D98E72; }
  .mark-dot  { fill: #E3C58A; }
  html[data-theme="dark"] .mark-tile { stroke: #4A4756; stroke-width: 1.5; }

  .brand-logo__text {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    line-height: 1;
  }

  .brand-logo__title {
    display: inline-flex;
    align-items: center;
    font-family: var(--display);
    font-variation-settings: var(--display-wide);
    font-weight: 800;
    font-size: 22px;
    line-height: 1;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .word-press {
    font-family: var(--mono);
    font-weight: 600;
    color: var(--accent-deep);
  }

  /* Block cursor: blinks in the masthead only. Static elsewhere. */
  .brand-logo__cursor {
    display: inline-block;
    width: .4em;
    height: .8em;
    margin-left: .22em;
    background: var(--accent-deep);
  }
  .brand-logo--masthead .brand-logo__cursor { animation: lp-blink 1.1s steps(1, end) infinite; }
  @keyframes lp-blink { 0%, 55% { opacity: 1; } 56%, 100% { opacity: 0; } }

  /* Masthead — primary header branding */
  .brand-logo--masthead {
    gap: 12px;
  }
  .brand-logo--masthead .brand-logo__mark svg {
    width: 36px;
    height: 36px;
  }
  .brand-logo--masthead .brand-logo__title {
    font-size: 26px;
    letter-spacing: 0.02em;
  }
  .brand-logo--masthead .brand-logo__tagline {
    font-size: 12px;
    letter-spacing: 0.08em;
  }

  .brand-logo__tagline {
    font-family: var(--mono);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  /* Compact — sticky nav, mobile. Tagline is dropped by the caller. */
  .brand-logo--compact { gap: 8px; }
  .brand-logo--compact .brand-logo__title { font-size: 18px; }
  .brand-logo--compact .brand-logo__mark svg { width: 24px; height: 24px; }

  /* Footer — horizontal, sleek and compact */
  .brand-logo--footer {
    display: inline-flex;
    flex-direction: row;
    align-items: center;
    gap: 9px;
  }
  .brand-logo--footer .brand-logo__title {
    font-size: 18px;
    color: var(--dark-ink);
  }
  .brand-logo--footer .word-press { color: var(--accent-light); }
  .brand-logo--footer .brand-logo__cursor { background: var(--accent-light); }
  .brand-logo--footer .brand-logo__mark svg { width: 22px; height: 22px; }

  /* Press-and-hold animation: masthead mark only. Plays twice shortly after
     load, then rests; replays on hover or tap (see script). JS adds
     .is-playing and removes it on animationend, so it never loops. */
  .mark-dot { transform-box: fill-box; transform-origin: center; }

  .brand-logo--masthead.is-playing .mark-dot    { animation: lp-dot 3.6s var(--lp-count, 1) both; }
  .brand-logo--masthead.is-playing .mark-arc    { animation: lp-arc 3.6s var(--lp-count, 1) both; }

  @keyframes lp-dot {
    0%, 6%   { transform: scale(1); }
    16%, 52% { transform: scale(.84); }
    60%      { transform: scale(1.07); }
    68%, 100% { transform: scale(1); }
  }
  @keyframes lp-arc {
    0%, 6%    { stroke-dasharray: 180 360; }
    52%       { stroke-dasharray: 250 360; }
    62%, 100% { stroke-dasharray: 180 360; }
  }

  @media (prefers-reduced-motion: reduce) {
    .brand-logo--masthead.is-playing .mark-dot,
    .brand-logo--masthead.is-playing .mark-arc { animation: none; }
    .brand-logo--masthead .brand-logo__cursor { animation: none; }
  }
</style>

<script>
  const logo = document.querySelector<HTMLElement>('.brand-logo--masthead');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (logo && !reduce) {
    const dot = logo.querySelector('.mark-dot');
    let playing = false;

    const play = (count: number) => {
      if (playing) return;
      playing = true;
      logo.style.setProperty('--lp-count', String(count));
      logo.classList.add('is-playing');
    };

    dot?.addEventListener('animationend', () => {
      logo.classList.remove('is-playing');
      playing = false;
    });

    // Twice on load, after the page has settled. Hover or tap replays once.
    window.setTimeout(() => play(2), 800);
    logo.addEventListener('pointerenter', () => play(1));
  }
</script>
