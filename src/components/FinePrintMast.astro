---
/** The Fine Print pillar masthead: asterisk mark, wordmark, tagline. Locked 11 Oct 2026. */
export interface Props { headingLevel?: 'div' | 'h1' }
const { headingLevel = 'div' } = Astro.props;
const Tag = headingLevel;
---
<div class="fp-mast">
  <div class="fp-mast__inner">
    <a href="/fine-print" class="fp-mark" aria-label="Fine Print explainers">
      <svg width="34" height="34" viewBox="0 0 40 40" aria-hidden="true"><g stroke="currentColor" stroke-width="6" stroke-linecap="round"><line x1="20" y1="5" x2="20" y2="35"></line><line x1="7" y1="12.5" x2="33" y2="27.5"></line><line x1="7" y1="27.5" x2="33" y2="12.5"></line></g></svg>
      <Tag class="fp-mark__word" style="margin:0">Fine Print</Tag>
    </a>
    <span class="fp-tagline">The part they hoped you'd skip.</span>
  </div>
</div>
