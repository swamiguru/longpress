---
interface Props {
  threshold?: number;
}

const { threshold = 400 } = Astro.props;
---

<button
  type="button"
  id="back-to-top"
  class="back-to-top"
  aria-label="Back to top of article"
  title="Back to top"
  data-threshold={threshold}
>
  <svg
    class="back-to-top__icon"
    viewBox="0 0 24 24"
    width="15"
    height="15"
    fill="none"
    stroke="currentColor"
    stroke-width="2.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M18 15l-6-6-6 6"/>
  </svg>
  <span class="back-to-top__text">Top</span>
</button>

<style>
  .back-to-top {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 900;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 14px;
    border-radius: 9999px;
    background: var(--surface, #FFFFFF);
    border: 1.5px solid var(--rule, #E2DDD3);
    color: var(--ink, #17182E);
    font-family: var(--mono, "Space Mono", monospace);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    box-shadow: 0 4px 16px rgba(23, 24, 46, 0.08);
    opacity: 0;
    visibility: hidden;
    transform: translateY(12px) scale(0.95);
    transition: opacity 0.22s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.22s cubic-bezier(0.16, 1, 0.3, 1),
                visibility 0.22s cubic-bezier(0.16, 1, 0.3, 1),
                border-color 0.15s ease,
                background-color 0.15s ease,
                color 0.15s ease,
                box-shadow 0.15s ease;
    user-select: none;
    touch-action: manipulation;
  }

  .back-to-top.is-visible {
    opacity: 1;
    visibility: visible;
    transform: translateY(0) scale(1);
  }

  .back-to-top:hover {
    background: var(--surface-hover, #F8F6F0);
    border-color: var(--accent, #E0552B);
    color: var(--accent-deep, #B83A14);
    box-shadow: 0 6px 20px rgba(224, 85, 43, 0.18);
    transform: translateY(-2px) scale(1.02);
  }

  .back-to-top:active {
    transform: translateY(0) scale(0.98);
  }

  .back-to-top:focus-visible {
    outline: 2px solid var(--accent, #E0552B);
    outline-offset: 3px;
  }

  .back-to-top__icon {
    flex-shrink: 0;
    transition: transform 0.15s ease;
  }

  .back-to-top:hover .back-to-top__icon {
    transform: translateY(-2px);
  }

  @media (max-width: 600px) {
    .back-to-top {
      bottom: 20px;
      right: 18px;
      padding: 7px 12px;
      font-size: 10.5px;
      box-shadow: 0 4px 14px rgba(23, 24, 46, 0.12);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .back-to-top {
      transition: opacity 0.15s ease, visibility 0.15s ease;
    }
    .back-to-top:hover,
    .back-to-top:hover .back-to-top__icon {
      transform: none;
    }
  }
</style>

<script>
  function initBackToTop() {
    const btn = document.getElementById('back-to-top');
    if (!btn) return;

    const threshold = parseInt(btn.getAttribute('data-threshold') || '400', 10);
    let isTicking = false;

    function checkScroll() {
      const scrollY = window.scrollY || window.pageYOffset || 0;
      const scrollHeight = document.documentElement.scrollHeight || document.body.scrollHeight;
      const innerHeight = window.innerHeight;

      // Only show if the document has enough scrollable depth
      const hasEnoughContent = scrollHeight > innerHeight * 1.35;

      if (hasEnoughContent && scrollY > threshold) {
        btn.classList.add('is-visible');
      } else {
        btn.classList.remove('is-visible');
      }
      isTicking = false;
    }

    function onScroll() {
      if (!isTicking) {
        window.requestAnimationFrame(checkScroll);
        isTicking = true;
      }
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });

    btn.addEventListener('click', () => {
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.scrollTo({
        top: 0,
        behavior: prefersReducedMotion ? 'auto' : 'smooth',
      });
    });

    // Initial check
    checkScroll();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initBackToTop);
  } else {
    initBackToTop();
  }
</script>
