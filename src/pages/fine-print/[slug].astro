---
import { existsSync } from 'node:fs';
import { getCollection } from 'astro:content';
import { publicFile } from '../../lib/seo/og.mjs';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageCrumb from '../../components/PageCrumb.astro';
import ShareButtons from '../../components/ShareButtons.astro';
import PreferredSource from '../../components/PreferredSource.astro';
import WhatsAppCta from '../../components/WhatsAppCta.astro';
import { fpPlain } from '../../lib/text/finePrint';
import { fpInline, FP_STATUS } from '../../lib/text/finePrint';
import '../../styles/fine-print.css';

export async function getStaticPaths() {
  const all = await getCollection('finePrint', ({ data }) => !data.draft);
  const sorted = all.sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());
  return sorted.map((entry) => ({
    params: { slug: entry.data.slug },
    props: {
      entry,
      others: sorted.filter((o) => o.data.slug !== entry.data.slug).slice(0, 3),
    },
  }));
}

const { entry, others } = Astro.props;
const d = entry.data;
const n = d.sources.length;
const t = (s: string) => fpInline(s, n);
const dateFmt = new Intl.DateTimeFormat('en-IN', { day: 'numeric', month: 'short', year: 'numeric' });

// Reading time across every text field: ~220 words a minute, never under 2.
const words = [
  d.oneLine, d.take,
  ...d.applies.map((a) => `${a.who} ${a.text}`),
  ...d.rules.map((r) => `${r.quote} ${r.plain}`),
  ...(d.costs?.rows ?? []).map((r) => `${r.item} ${r.rule} ${r.amount}`),
  ...d.steps, ...d.finePrint, ...d.unknowns,
].join(' ').split(/\s+/).filter(Boolean).length;
const minutes = Math.max(2, Math.round(words / 220));
const lastLog = [...d.changelog].sort((a, b) => b.date.valueOf() - a.date.valueOf());

// Share / Discover card: the piece's own, made by scripts/og/fine-print-cards.py,
// else the shared Fine Print card. Never the Long Press default.
const ownCard = `/images/fine-print/${d.slug}.png`;
const shareImage = existsSync(publicFile(ownCard)) ? ownCard : '/images/fine-print/default.png';
---
<BaseLayout title={d.title} description={d.description} schema="NewsArticle" published={d.published} updated={d.lastChecked} image={shareImage} wide>

  <div class="fp fp--doc">
    <PageCrumb label="Fine Print" href="/fine-print" />

    <header class="ph ph--story">
      <div class="ph__tags">
        <span class="ph__tag">Explainer &middot; {d.category}</span>
      </div>
      <h1 class="ph__title">{d.title}</h1>
      <div class="byline">
        <span class="byline__mark"><img src="/images/about/swami-headshot.jpg" alt="" width="38" height="38" loading="lazy" decoding="async" /></span>
        <span class="byline__who">
          <strong class="byline__name">{d.author}</strong>
          <span class="byline__date">Published <time datetime={d.published.toISOString()}>{dateFmt.format(d.published)}</time></span>
        </span>
        <span class="byline__read">{minutes} min read</span>
      </div>
      <div class="fp-share">
        <ShareButtons title={d.title} description={fpPlain(d.oneLine)} url={`/fine-print/${d.slug}`} compact>
          <PreferredSource />
        </ShareButtons>
      </div>
    </header>

    <article class="fp-article">

      {d.keyFigures && d.keyFigures.length > 0 && (
        <section class="fp-figs" aria-label="Key figures">
          {d.keyFigures.map((f) => (
            <div class={`fp-fig${f.highlight ? ' fp-fig--hl' : ''}`}>
              <div class="fp-fig__big">{f.big}</div>
              <div class="fp-fig__label">{f.label}</div>
            </div>
          ))}
        </section>
      )}

      <div class="fp-trust">
        <div><span>Last checked</span><b><time datetime={d.lastChecked.toISOString()}>{dateFmt.format(d.lastChecked)}</time></b></div>
        {d.nextCheck && <div><span>Next check</span><b><time datetime={d.nextCheck.toISOString()}>{dateFmt.format(d.nextCheck)}</time></b></div>}
        <div><span>Read from</span><b>{n} {n === 1 ? 'source' : 'sources'}</b></div>
      </div>

      <section class="fp-oneline" aria-labelledby="fp-oneline">
        <h2 id="fp-oneline" class="fp-label">In one line</h2>
        <p set:html={t(d.oneLine)} />
      </section>

      <section class="fp-section" aria-labelledby="fp-applies">
        <h2 id="fp-applies" class="fp-h2">Does this apply to you?</h2>
        <p class="fp-lede">Find yourself in the list.</p>
        <div class="fp-checks">
          {d.applies.map((a) => {
            const s = FP_STATUS[a.status];
            return (
              <div class="fp-check">
                <div class="fp-check__top">
                  <div class="fp-check__who">{a.who}</div>
                  <span class={`fp-chip fp-chip--${s.tone}`}>{s.label}</span>
                </div>
                <p class="fp-check__text" set:html={t(a.text)} />
              </div>
            );
          })}
        </div>
      </section>

      {d.rules.length > 0 && (
        <section class="fp-section" aria-labelledby="fp-rules">
          <h2 id="fp-rules" class="fp-h2">What the rule actually says</h2>
          <p class="fp-lede">The plain version first, then the line from the primary document.</p>
          <div class="fp-rules">
            {d.rules.map((r) => (
              <div class="fp-rule">
                <span class="fp-lab">In plain words</span>
                <div class="fp-rule__plain" set:html={t(r.plain)} />
                <div class="fp-rule__quote"><span class="fp-lab">The document says</span><span set:html={t(r.quote)} /></div>
              </div>
            ))}
          </div>
        </section>
      )}

      {d.costs && (
        <section class="fp-section" aria-labelledby="fp-costs">
          <h2 id="fp-costs" class="fp-h2">{d.costs.title}</h2>
          {d.costs.note && <p class="fp-lede" set:html={t(d.costs.note)} />}
          <div class="fp-receipt">
            <div class="fp-receipt__tear fp-receipt__tear--t" aria-hidden="true"></div>
            <div class="fp-receipt__body">
              <div class="fp-receipt__head">{d.costs.payerLabel}</div>
              <ul class="fp-receipt__rows">
                {d.costs.rows.map((r) => (
                  <li>
                    <div class="fp-receipt__l1"><span set:html={t(r.item)} /><span class="fp-receipt__amt">{r.highlight ? <span class="fp-hl">{r.amount}</span> : r.amount}</span></div>
                    <div class="fp-receipt__l2" set:html={t(r.rule)} />
                  </li>
                ))}
              </ul>
              {d.costs.footer && (
                <div class="fp-receipt__total"><span>{d.costs.footer.label}</span><span class="fp-hl">{d.costs.footer.amount}</span></div>
              )}
            </div>
            <div class="fp-receipt__tear fp-receipt__tear--b" aria-hidden="true"></div>
          </div>
        </section>
      )}

      {d.steps.length > 0 && (
        <section class="fp-section" aria-labelledby="fp-steps">
          <h2 id="fp-steps" class="fp-h2">What to do</h2>
          <ol class="fp-steps">
            {d.steps.map((s, i) => (
              <li><span class="fp-steps__n" aria-hidden="true">{i + 1}</span><span set:html={t(s)} /></li>
            ))}
          </ol>
        </section>
      )}

      <WhatsAppCta variant="strip" location="fine_print_mid" heading="Fine Print on WhatsApp" text="One explainer every Saturday, on the Long Press channel." />

      <section class="fp-section fp-fine" aria-labelledby="fp-fine">
        <div class="fp-fine__head">
          <svg width="22" height="22" viewBox="0 0 40 40" aria-hidden="true"><g stroke="currentColor" stroke-width="6" stroke-linecap="round"><line x1="20" y1="5" x2="20" y2="35"></line><line x1="7" y1="12.5" x2="33" y2="27.5"></line><line x1="7" y1="27.5" x2="33" y2="12.5"></line></g></svg>
          <h2 id="fp-fine" class="fp-h2">The fine print</h2>
        </div>
        <ul class="fp-list">
          {d.finePrint.map((f) => <li set:html={t(f)} />)}
        </ul>
      </section>

      {d.unknowns.length > 0 && (
        <section class="fp-section" aria-labelledby="fp-unknowns">
          <h2 id="fp-unknowns" class="fp-h2" style="margin-bottom:14px">What we don't know yet</h2>
          <ul class="fp-list">
            {d.unknowns.map((u) => <li set:html={t(u)} />)}
          </ul>
        </section>
      )}

      <section class="fp-section fp-take" aria-labelledby="fp-take">
        <h2 id="fp-take" class="fp-label">Our take</h2>
        <p set:html={t(d.take)} />
      </section>

      <div class="fp-record">
      <section class="fp-log" aria-labelledby="fp-log">
        <h2 id="fp-log" class="fp-label">Change log</h2>
        <div class="fp-log__rows">
          {lastLog.map((c) => (
            <div class="fp-log__row"><span class="fp-log__date">{dateFmt.format(c.date)}</span><span set:html={t(c.text)} /></div>
          ))}
          {d.nextCheck && (
            <div class="fp-log__row fp-log__row--next"><span class="fp-log__date">Next check</span><span>{dateFmt.format(d.nextCheck)}, or sooner if the rules change.</span></div>
          )}
        </div>
      </section>

      <section class="fp-sources" aria-labelledby="fp-sources">
        <h2 id="fp-sources" class="fp-label">Sources</h2>
        <ol>
          {d.sources.map((s, i) => (
            <li id={`fp-src-${i + 1}`}><a href={s.url} rel="noopener" target="_blank">{s.label}</a></li>
          ))}
        </ol>
      </section>
      </div>

      <WhatsAppCta variant="card" location="fine_print_end" heading="Follow Long Press on WhatsApp" text="Next Saturday's Fine Print, and the Daily Five every morning." />

      <div class="fp-share">
        <ShareButtons title={d.title} description={fpPlain(d.oneLine)} url={`/fine-print/${d.slug}`} />
      </div>

      {(d.video || others.length > 0) && (
        <section class="fp-end">
          {d.video && (
            <a class="fp-end__video" href={d.video.url} rel="noopener" target="_blank">
              <span class="fp-end__eyebrow">Watch in Hindi</span>
              <span class="fp-end__title">{d.video.title}</span>
            </a>
          )}
          {others.length > 0 && (
            <div class="fp-end__box">
              <span class="fp-end__eyebrow">More in Fine Print</span>
              <ul class="fp-end__list">
                {others.map((o) => <li><a href={`/fine-print/${o.data.slug}`}>{o.data.title}</a></li>)}
              </ul>
            </div>
          )}
        </section>
      )}
    </article>
  </div>
</BaseLayout>
