---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { fpPlain } from '../../lib/text/finePrint';
import '../../styles/fine-print.css';

const pieces = (await getCollection('finePrint', ({ data }) => !data.draft))
  .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());
const dateFmt = new Intl.DateTimeFormat('en-IN', { day: 'numeric', month: 'short', year: 'numeric' });
---
<BaseLayout
  title="Fine Print: India's tech rules and prices, explained"
  description="Plain-language explainers of the rules, prices and services that change things for people in India. Primary documents, rupee maths, kept current."
  wide
>

  <div class="fp">
    <div class="fp-index">
      <header class="ph ph--landing">
        <span class="ph__tag">Pillar 03 &middot; Explainers &middot; One a week</span>
        <h1 class="ph__title">
          <svg width="40" height="40" viewBox="0 0 40 40" aria-hidden="true"><g stroke="currentColor" stroke-width="6" stroke-linecap="round"><line x1="20" y1="5" x2="20" y2="35"></line><line x1="7" y1="12.5" x2="33" y2="27.5"></line><line x1="7" y1="27.5" x2="33" y2="12.5"></line></g></svg>
          Fine Print
        </h1>
        <p class="ph__stand">Fine print is the part of a contract, a bill or a government circular that most people skip, and it's usually where the catch is. These explainers read it for you from the source document, work out what it costs in <span class="fp-hl">rupees</span>, and stay up to date.</p>
        <p class="ph__promise">Primary documents <span aria-hidden="true">&middot;</span> Rupee maths <span aria-hidden="true">&middot;</span> Kept current</p>
      </header>

      {pieces.length === 0 ? (
        <p class="fp-empty">The first explainers land soon. Follow the WhatsApp channel to get them first.</p>
      ) : (
        <div class="fp-grid">
          {pieces.map((p, i) => (
            <a href={`/fine-print/${p.data.slug}`} class:list={['fp-card', { 'fp-card--lead': i === 0 }]}>
              <span class="fp-meta">
                <span>{p.data.category}</span>
                <span class="fp-stamp">Last checked {dateFmt.format(p.data.lastChecked)}</span>
              </span>
              <h2 class="fp-card__title">{p.data.title}</h2>
              <p class="fp-card__line">{fpPlain(p.data.oneLine)}</p>
              <span class="fp-card__more">Read the explainer &rarr;</span>
            </a>
          ))}
        </div>
      )}
    </div>
  </div>
</BaseLayout>
