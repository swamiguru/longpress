---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdSlot from '../../components/AdSlot.astro';
import { getArticleReadingTime } from '../../lib/readingTime';

export async function getStaticPaths() {
  const stories = await getCollection('stories', ({ data }) => !data.draft);
  const topics = [...new Set(stories.flatMap((s) => s.data.topics))];
  return topics.map((topic) => ({
    params: { topic },
    props: { stories: stories.filter((s) => s.data.topics.includes(topic)) },
  }));
}

const { topic } = Astro.params;
const { stories } = Astro.props;
const sorted = [...stories].sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());
const long = new Intl.DateTimeFormat('en-IN', { dateStyle: 'long' });
---
<BaseLayout title={topic!} description={`Everything Long Press has published on ${topic}.`}>
  <div class="page-head">
    <span class="eyebrow">Topic</span>
    <h1>{topic}</h1>
    <p class="standfirst">{sorted.length} {sorted.length === 1 ? 'piece' : 'pieces'}.</p>
  </div>

  <ul class="entries">
    {sorted.map((s, i) => (
      <>
        {i === 6 && <li class="ad-row"><AdSlot placement="hub" /></li>}
        <li>
          <div class="entry__meta-row">
            <time class="dateline entry__meta" datetime={s.data.published.toISOString()}>
              {long.format(s.data.published)}
            </time>
            <span class="entry__reading-time">{getArticleReadingTime(s).text}</span>
          </div>
          <p class="entry__title"><a href={`/${s.data.slug}`}>{s.data.title}</a></p>
          <p class="entry__desc">{s.data.description}</p>
        </li>
      </>
    ))}
  </ul>
</BaseLayout>
