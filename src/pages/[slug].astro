---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import AdSlot from '../components/AdSlot.astro';
import RelatedArticles from '../components/RelatedArticles.astro';
import PreviouslyOn from '../components/PreviouslyOn.astro';
import WhatsAppCta from '../components/WhatsAppCta.astro';
import { relatedFor } from '../lib/related';
import ShareButtons from '../components/ShareButtons.astro';
import PreferredSource from '../components/PreferredSource.astro';
import PageCrumb from '../components/PageCrumb.astro';
import { getResponsiveImage } from '../lib/images';
import { isIndexableTopic } from '../lib/seo/topics.mjs';
import { getArticleReadingTime } from '../lib/readingTime';
import { hostLabel } from '../lib/text/inline.mjs';

export async function getStaticPaths() {
  const stories = await getCollection('stories', ({ data }) => !data.draft);
  // data.slug, never the filename - headlines stay rewritable.
  return stories.map((story) => ({
    params: { slug: story.data.slug },
    props: { story },
  }));
}

const { story } = Astro.props;
const { Content } = await render(story);
const d = story.data;
// Stories already linked by "Previously on Long Press" are left out of Related Articles.
const previouslySlugs = (await relatedFor(`story:${d.slug}`)).flatMap((l) => (l.slug ? [l.slug] : []));
const long = new Intl.DateTimeFormat('en-IN', { dateStyle: 'long' });
const short = new Intl.DateTimeFormat('en-IN', { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric' });
const readingTime = getArticleReadingTime(story);
const leadSrc = d.image ?? d.heroImage ?? (d.category === 'known-issue' ? '/images/fallback/column.png' : '/images/fallback/news.png');
const leadIsSquare = !!d.image;
// heroImage (no square `image` set) renders as a 16:9 crop; give it a
// wide box to match, or the fixed square box crops its sides off.
const leadIsWide = !leadIsSquare && !!d.heroImage;
const lead = getResponsiveImage(leadSrc, { aspectRatio: leadIsSquare || !d.heroImage ? '1/1' : '16/9', customSizes: '(max-width: 759px) 100vw, 46vw' });
// Known Issue head strip: days open (from reportedOn) or years open (from openSince).
// Days are rendered at build time and refreshed in the browser, so the number
// never sits stale between deploys.
const isKI = d.category === 'known-issue';
const reportedISO = d.reportedOn ? d.reportedOn.toISOString().slice(0, 10) : null;
const now = new Date();
const daysOpen = d.reportedOn
  ? Math.max(0, Math.floor((Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate()) - d.reportedOn.getTime()) / 86400000))
  : null;
const yearsOpen = !d.reportedOn && d.openSince ? Math.max(0, now.getUTCFullYear() - d.openSince) : null;
const firstSeen = d.reportedOn
  ? new Intl.DateTimeFormat('en-IN', { month: 'short', year: 'numeric', timeZone: 'UTC' }).format(d.reportedOn)
  : d.openSince ? String(d.openSince) : null;
const showStrip = isKI && (daysOpen !== null || yearsOpen !== null);
// Operator's read: the first sentence is set large as the headline of the opinion.
// Only when it is a clean, headline-sized sentence; otherwise the whole text stays body copy.
const readMatch = d.operatorsRead ? d.operatorsRead.match(/^(.+?[.!?])\s+([\s\S]+)$/) : null;
const readSplit = !!readMatch && readMatch[1].length >= 20 && readMatch[1].length <= 170;
const readLead = readSplit ? readMatch![1] : null;
const readRest = readSplit ? readMatch![2] : (d.operatorsRead ?? '');
const readSig = /swami/i.test(d.author ?? '') ? `${d.author} \u00b7 11+ years leading product` : (d.author ?? '');
const leadAlt = (d.image ? d.imageAlt : d.heroImageAlt) || '';
const leadCaption = d.image ? d.imageCaption : d.heroImageCaption;
---
<BaseLayout
  title={d.title}
  description={d.description}
  schema="NewsArticle"
  published={d.published}
  updated={d.updated}
  image={d.heroImage || d.image}
  imageAlt={d.heroImage ? d.heroImageAlt : d.imageAlt}
  seoTitle={d.seoTitle}
  wide
>
  <div class={`pg ${d.category === 'known-issue' ? 'pg--ki' : 'pg--daily'} pg--article`}>
  <article>
    {d.category === 'known-issue'
      ? <PageCrumb label="Known Issue" href="/known-issue" />
      : <PageCrumb label={d.category.replace(/-/g, ' ')} />}

    <header class={`ph ph--story${d.category === 'known-issue' ? ' ph--dark' : ''}`}>
      <div class={`art-head${leadSrc ? ' art-head--media' : ''}`}>
        <div class="art-head__text">
          <span class="ph__tag">{d.category === 'known-issue' ? 'Known Issue \u00b7 Opinion' : d.category.replace(/-/g, ' ')}</span>
          <h1 class="ph__title">{d.title}</h1>
          <p class="ph__stand">{d.description}</p>
          {d.trigger && (
            <p class="column-trigger">
              <span class="column-trigger__label">Not today&rsquo;s news</span>
              {d.trigger}
            </p>
          )}
          {showStrip && (
            <div class="ki-strip">
              <div>
                <span class="ki-strip__label">Open for</span>
                <span class="ki-strip__count">
                  {daysOpen !== null
                    ? <b data-open-since={reportedISO}>{daysOpen.toLocaleString('en-IN')}</b>
                    : <b>{yearsOpen}</b>}
                  <span class="ki-strip__unit">{daysOpen !== null ? 'days' : (yearsOpen === 1 ? 'year' : 'years')}</span>
                </span>
              </div>
              {firstSeen && (
                <div>
                  <span class="ki-strip__label">First seen</span>
                  <span class="ki-strip__fact">{firstSeen}</span>
                </div>
              )}
              {d.workaround && (
                <div>
                  <span class="ki-strip__label">Workaround</span>
                  <span class="ki-strip__fact">{d.workaround}</span>
                </div>
              )}
            </div>
          )}
          <div class="byline">
            <span class="byline__mark"><img src="/images/about/swami-headshot.jpg" alt="" width="38" height="38" loading="lazy" decoding="async" /></span>
            <span class="byline__who">
              <strong class="byline__name">{d.author}</strong>
              <span class="byline__date">
                <time datetime={d.published.toISOString()}>{short.format(d.published)}</time>
                {d.updated && <> &middot; <time datetime={d.updated.toISOString()}>Updated {short.format(d.updated)}</time></>}
              </span>
            </span>
            <span class="byline__read">{readingTime.text}</span>
          </div>
          <ShareButtons
            title={d.title}
            description={d.description}
            compact
            class="share-bar--top"
          >
            <PreferredSource theme={d.category === 'known-issue' ? 'dark' : 'light'} />
          </ShareButtons>
        </div>
        {leadSrc && (
          <figure class={`art-head__media${leadIsWide ? ' art-head__media--wide' : ''}`}>
            <img src={lead.src} srcset={lead.srcset} sizes={lead.sizes} width={lead.width} height={lead.height} alt={leadAlt} loading="eager" fetchpriority="high" decoding="async" id="article-lead-image" />
            {leadCaption && <figcaption>{leadCaption}</figcaption>}
          </figure>
        )}
      </div>
    </header>

    <div class="prose"><Content /></div>

    {d.sources && d.sources.length > 0 && (
      <p class="brief__source">
        <span class="brief__source-label">Sources</span>
        {d.sources.map((s) => (
          <a href={s.url} rel="noopener" target="_blank" class="brief__source-link">
            {s.label || hostLabel(s.url)} &nearr;
          </a>
        ))}
      </p>
    )}

    {(d.whoBenefits || d.operatorsRead || d.verdict) && (
      <section class="take" aria-label="Known Issue take">
        <div class="take__top">
          <svg class="take__mark" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2"></circle><path d="M12 3a9 9 0 0 1 0 18" fill="none" stroke="var(--accent)" stroke-width="2.4"></path><circle cx="12" cy="12" r="2.6" fill="currentColor"></circle></svg>
          <span class="take__tag">Known Issue &middot; The take</span>
          <span class="take__where">Where we land</span>
        </div>

        {(d.whoBenefits || d.operatorsRead) && (
          <div class={`take__cols${d.whoBenefits && d.operatorsRead ? ' take__cols--two' : ''}`}>
            {d.whoBenefits && (
              <div class="column-callout column-callout--money">
                <span class="column-callout__label">
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="8.5"></circle><path d="M12 7v10M9 9.5c0-1.1 1.3-2 3-2s3 .9 3 2-1.3 1.7-3 2-3 .9-3 2 1.3 2 3 2 3-.9 3-2"></path></svg>
                  Plain about the money
                </span>
                <p>{d.whoBenefits}</p>
                <svg class="column-callout__coin" viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="7" aria-hidden="true"><circle cx="50" cy="50" r="42"></circle><circle cx="50" cy="50" r="27"></circle></svg>
              </div>
            )}
            {d.operatorsRead && (
              <div class="column-pullquote">
                <div class="column-pullquote__who">
                  <img src="/images/about/swami-headshot.jpg" alt="" width="44" height="44" loading="lazy" decoding="async" />
                  <span class="column-pullquote__label">The operator&rsquo;s read</span>
                </div>
                {readLead && <p class="column-pullquote__lead">{readLead}</p>}
                <p class="column-pullquote__rest">{readRest}</p>
                {readSig && <span class="column-pullquote__sig">{readSig}</span>}
              </div>
            )}
          </div>
        )}

        {d.verdict && (
          <div class={`column-verdict column-verdict--${d.verdict}`} role="group" aria-label="Verdict">
            <div class="column-verdict__word">
              {d.verdict === 'buy' && (
                <svg class="column-verdict__icon" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="24" cy="24" r="19"></circle><path d="M15 25l6 6 12-13"></path></svg>
              )}
              {d.verdict === 'wait' && (
                <svg class="column-verdict__icon" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" aria-hidden="true"><circle cx="24" cy="24" r="19"></circle><path d="M19 16v16M29 16v16"></path></svg>
              )}
              {d.verdict === 'skip' && (
                <svg class="column-verdict__icon" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" aria-hidden="true"><circle cx="24" cy="24" r="19"></circle><path d="M16 16l16 16M32 16L16 32"></path></svg>
              )}
              <div>
                <span class="column-verdict__label">The call</span>
                <span class="column-verdict__badge">{d.verdict}</span>
              </div>
            </div>
            {d.verdictNote && <p class="column-verdict__note">{d.verdictNote}</p>}
          </div>
        )}
      </section>
    )}

    <div class="article-share-end" style="margin-top: var(--s6); margin-bottom: var(--s6); padding-top: var(--s5); border-top: 1px solid var(--rule);">
      <ShareButtons
        title={d.title}
        description={d.description}
      />
    </div>

    <AdSlot placement="article" />

    <WhatsAppCta
      variant="card"
      location={d.category === 'known-issue' ? 'known_issue_end' : 'story_end'}
      heading="Follow Long Press on WhatsApp"
      text="New briefs and columns, posted to the channel."
    />

    <div class="story-footer-card">
      <div class="story-footer-card__main">
        <span class="eyebrow">{d.category === 'known-issue' ? 'Known Issue' : 'Long Press'}</span>
        <h3 class="story-footer-card__name">Swami Guru</h3>
        <p class="story-footer-card__bio">
          {d.category === 'known-issue'
            ? "Swami's column on the things that stay broken. 11+ years leading product, most recently at Cond\u00e9 Nast."
            : '11+ years leading product, most recently at Cond\u00e9 Nast. Now writing Long Press from Bengaluru.'}
        </p>
      </div>
      <div class="story-footer-card__actions">
        {d.category === 'known-issue' ? (
          <a href="/known-issue" class="chip chip--primary">More Known Issue Opinions &rarr;</a>
        ) : (
          <a href="/daily" class="chip chip--primary">Read Today's Brief &rarr;</a>
        )}
        <a href="/about" class="chip chip--secondary">About Swami</a>
      </div>
    </div>

    {d.topics.length > 0 && (
      <nav class="chips" aria-label="Topics">
        {d.topics.map((t) => isIndexableTopic(t)
          ? <a class="chip" href={`/topics/${t}`}>#{t}</a>
          : <span class="chip">#{t}</span>)}
      </nav>
    )}

    <PreviouslyOn id={`story:${d.slug}`} />

    <RelatedArticles
      currentSlug={d.slug}
      currentCategory={d.category}
      currentTopics={d.topics}
      exclude={previouslySlugs}
    />
  </article>
  </div>
  <script is:inline>
    (function () {
      var el = document.querySelector('[data-open-since]');
      if (!el) return;
      var p = el.getAttribute('data-open-since').split('-');
      var n = new Date();
      var days = Math.max(0, Math.floor((Date.UTC(n.getFullYear(), n.getMonth(), n.getDate()) - Date.UTC(+p[0], +p[1] - 1, +p[2])) / 864e5));
      el.textContent = days.toLocaleString('en-IN');
    })();
  </script>
</BaseLayout>

<style>
  /* ============================================================
     Known Issue structure — the column's four tenets, rendered.
     Not today's news (kicker) / Plain about the money (callout) /
     The operator's read (pull-quote) / A verdict (badge).
     Scoped to the story page only.
     ============================================================ */
  .column-trigger {
    margin: var(--s4) 0 0;
    max-width: var(--measure);
    font-size: 14.5px;
    font-style: italic;
    line-height: 1.55;
    color: var(--muted);
  }
  .column-trigger__label {
    display: inline-block;
    margin-right: 8px;
    padding: 2px 9px;
    background: var(--surface);
    border: 1px solid var(--rule);
    font-family: var(--mono);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-style: normal;
    color: var(--ink-soft);
    vertical-align: middle;
  }
  /* In the midnight head the kicker is body copy, not a caption: upright, 16px,
     light ink. The light-page grey and italic above were washing out on dark. */
  .ph--dark .column-trigger {
    max-width: 60ch;
    font-family: var(--body);
    font-size: 16px;
    font-style: normal;
    font-weight: 400;
    line-height: 1.6;
    color: var(--dark-utility);
  }
  .ph--dark .column-trigger__label {
    margin-right: 10px;
    padding: 4px 10px;
    font-size: 11px;
    background: var(--dark-utility);
    border-color: var(--dark-utility);
    color: var(--dark-ground);
  }

  /* ============================================================
     Known Issue, lite (12 Oct 2026). An ordinary article under the
     midnight head. The bug idea survives in three places: the day
     counter in the head, a wavy underline on the one defective
     phrase in the body (<mark>), and the plain verdict block.
     ============================================================ */
  .ki-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 32px;
    margin-top: var(--s4);
    padding-top: 14px;
    border-top: 1px solid var(--dark-rule);
  }
  .ki-strip > div { display: grid; gap: 6px; align-content: start; min-width: 0; }
  .ki-strip__label {
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--dark-soft);
  }
  .ki-strip__count {
    font-family: var(--display);
    font-weight: 900;
    font-size: 40px;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--accent-light);
    font-variant-numeric: tabular-nums;
  }
  .ki-strip__unit {
    margin-left: 6px;
    font-family: var(--mono);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--dark-soft);
  }
  .ki-strip__fact { font-size: 15px; line-height: 1.45; color: var(--dark-ink); max-width: 26ch; }

  /* Markdown content is rendered outside this component's scope. */
  :global(.pg--ki .prose mark) {
    background: none;
    color: inherit;
    text-decoration: underline wavy var(--accent);
    text-decoration-thickness: 1.5px;
    text-underline-offset: 4px;
  }

  /* ============================================================
     The take (12 Oct 2026). The opinion closes the article in its own
     midnight panel, on the same grid as the head. Three parts, three
     colors: money (teal slab), operator's read (cream card, orange
     shadow), verdict (solid band with an icon).
     ============================================================ */
  .take {
    position: relative;
    display: grid;
    gap: 20px;
    margin-top: var(--s6);
    padding: 24px clamp(16px, 4vw, 36px) clamp(16px, 4vw, 36px);
    overflow: hidden;
    background: var(--dark-ground);
    color: var(--dark-ink);
    border: 1px solid var(--dark-rule);
  }
  .take::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: linear-gradient(rgba(124,195,182,.07) 1px, transparent 1px), linear-gradient(90deg, rgba(124,195,182,.07) 1px, transparent 1px);
    background-size: 32px 32px;
  }
  .take > * { position: relative; }
  .take__top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--dark-rule);
  }
  .take__mark { width: 22px; height: 22px; flex: none; color: var(--dark-ink); }
  .take__tag {
    padding: 6px 10px;
    background: var(--teal-light);
    color: #17182E;
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }
  .take__where {
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--dark-soft);
  }
  .take__cols { display: grid; gap: 20px; grid-template-columns: minmax(0, 1fr); align-items: stretch; }
  @media (min-width: 860px) { .take__cols--two { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); } }

  /* money: teal slab */
  .column-callout {
    position: relative;
    overflow: hidden;
    padding: 22px 24px 26px;
    background: #2F6A62;
    color: #F4F1E8;
  }
  .column-callout__label {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 14px;
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #D6EFE9;
  }
  .column-callout__label svg { flex: none; }
  .column-callout p {
    position: relative;
    z-index: 1;
    margin: 0;
    max-width: none;
    font-size: 16.5px;
    line-height: 1.62;
    color: inherit;
  }
  .column-callout__coin {
    position: absolute;
    right: -30px;
    bottom: -40px;
    width: 190px;
    height: 190px;
    color: #FFFFFF;
    opacity: 0.1;
    pointer-events: none;
  }

  /* operator's read: cream card, orange offset */
  .column-pullquote {
    display: grid;
    gap: 14px;
    align-content: start;
    padding: 22px 26px 26px;
    background: #F4F1E8;
    color: #17182E;
    box-shadow: 6px 6px 0 var(--accent);
  }
  .column-pullquote__who { display: flex; align-items: center; gap: 12px; }
  .column-pullquote__who img {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--accent);
  }
  .column-pullquote__label {
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #5E5C70;
  }
  .column-pullquote__lead {
    margin: 0;
    max-width: none;
    font-family: var(--display);
    font-weight: 800;
    font-size: clamp(22px, 2.9vw, 29px);
    line-height: 1.2;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }
  .column-pullquote__rest {
    margin: 0;
    max-width: none;
    font-size: 16.5px;
    line-height: 1.62;
    color: #34364F;
  }
  .column-pullquote__sig {
    padding-top: 12px;
    border-top: 1px solid #CFC8B3;
    font-family: var(--mono);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: #5E5C70;
  }

  /* verdict: a solid band you can read across a room */
  .column-verdict {
    position: relative;
    overflow: hidden;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 0 clamp(18px, 3vw, 36px);
    padding: clamp(18px, 3vw, 28px) clamp(18px, 3vw, 32px);
    color: #FFFFFF;
    background: #A83D18;
  }
  .column-verdict--buy { background: #2F6A62; }
  .column-verdict--wait { background: #C84418; }
  .column-verdict--skip { background: #A83D18; }
  .column-verdict::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.08;
    background: repeating-linear-gradient(135deg, #FFFFFF 0 2px, transparent 2px 14px);
  }
  .column-verdict > * { position: relative; z-index: 1; }
  .column-verdict__word { display: flex; align-items: center; gap: 16px; }
  .column-verdict__icon { width: clamp(44px, 6vw, 64px); height: clamp(44px, 6vw, 64px); flex: none; }
  .column-verdict__label {
    display: block;
    margin-bottom: 8px;
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .column-verdict__badge {
    display: block;
    font-family: var(--display);
    font-variation-settings: var(--display-wide);
    font-weight: 900;
    font-size: clamp(46px, 8vw, 84px);
    line-height: 0.9;
    letter-spacing: 0.01em;
    text-transform: uppercase;
  }
  .column-verdict__note {
    margin: 0;
    max-width: 52ch;
    font-size: clamp(16px, 1.9vw, 19px);
    font-weight: 500;
    line-height: 1.55;
    color: #FFFFFF;
  }
  @media (max-width: 700px) {
    .column-verdict { grid-template-columns: 1fr; gap: 14px; }
    .ki-strip__count { font-size: 34px; }
  }
</style>
