---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ResponsiveImage from '../components/ResponsiveImage.astro';
import AdSlot from '../components/AdSlot.astro';
import RelatedArticles from '../components/RelatedArticles.astro';
import ShareButtons from '../components/ShareButtons.astro';
import { getArticleReadingTime } from '../lib/readingTime';

export async function getStaticPaths() {
  const stories = await getCollection('stories', ({ data }) => !data.draft);
  // data.slug, never the filename - headlines stay rewritable.
  return stories.map((story) => ({
    params: { slug: story.data.slug },
    props: { story },
  }));
}

const { story } = Astro.props;
const { Content } = await render(story);
const d = story.data;
const long = new Intl.DateTimeFormat('en-IN', { dateStyle: 'long' });
const readingTime = getArticleReadingTime(story);
---
<BaseLayout
  title={d.title}
  description={d.description}
  schema="NewsArticle"
  published={d.published}
  updated={d.updated}
  image={d.heroImage || d.image}
>
  <article>
    <nav class="article-breadcrumb" aria-label="Breadcrumb">
      <a href="/">&larr; Front Page</a>
      <span class="article-breadcrumb__sep">/</span>
      {d.category === 'known-issue' ? (
        <a href="/known-issue" class="article-breadcrumb__curr" style="color: inherit; text-decoration: underline;">Known Issue &middot; Opinion</a>
      ) : (
        <span class="article-breadcrumb__curr">{d.category.replace(/-/g, ' ')}</span>
      )}
    </nav>

    <div class="page-head page-head--article" style="margin-top: var(--s3);">
      <span class="eyebrow" data-category={d.category}>{d.category === 'known-issue' ? 'Known Issue \u00b7 Opinion' : d.category.replace(/-/g, ' ')}</span>
      <h1>{d.title}</h1>
      <p class="standfirst">{d.description}</p>
      {d.trigger && (
        <p class="column-trigger">
          <span class="column-trigger__label">Not today&rsquo;s news</span>
          {d.trigger}
        </p>
      )}
    </div>

    <div class="article__meta">
      <span class="dateline">By Swami</span>
      <time class="dateline" datetime={d.published.toISOString()}>{long.format(d.published)}</time>
      {d.updated && (
        <time class="dateline" datetime={d.updated.toISOString()}>Updated {long.format(d.updated)}</time>
      )}
      <span class="dateline reading-time">{readingTime.text}</span>
    </div>

    <ShareButtons
      title={d.title}
      description={d.description}
    />

    {d.heroImage ? (
      <ResponsiveImage
        src={d.heroImage}
        alt={d.heroImageAlt || d.title}
        caption={d.heroImageCaption}
        aspectRatio="16/9"
        loading="eager"
        fetchpriority="high"
        figureClass="article-hero"
        captionClass="article-hero__caption"
        class="article-hero__image"
        id="article-lead-image"
      />
    ) : d.image && (
      <ResponsiveImage
        src={d.image}
        alt={d.imageAlt || d.title}
        caption={d.imageCaption}
        aspectRatio="1/1"
        loading="eager"
        fetchpriority="high"
        figureClass="article-hero"
        captionClass="article-hero__caption"
        class="article-hero__image"
        id="article-lead-image"
      />
    )}

    <div class="prose"><Content /></div>

    {(d.whoBenefits || d.operatorsRead || d.verdict) && (
      <div class="column-structure" aria-label="Known Issue analysis">
        {d.whoBenefits && (
          <div class="column-callout column-callout--money">
            <span class="column-callout__label">Plain about the money</span>
            <p>{d.whoBenefits}</p>
          </div>
        )}
        {d.operatorsRead && (
          <div class="column-pullquote">
            <span class="column-pullquote__label">The operator&rsquo;s read</span>
            <p>{d.operatorsRead}</p>
          </div>
        )}
        {d.verdict && (
          <div class="column-verdict">
            <span class={`column-verdict__badge column-verdict__badge--${d.verdict}`}>{d.verdict}</span>
            {d.verdictNote && <p class="column-verdict__note">{d.verdictNote}</p>}
          </div>
        )}
      </div>
    )}

    <div class="article-share-end" style="margin-top: var(--s6); margin-bottom: var(--s6); padding-top: var(--s5); border-top: 1px solid var(--rule);">
      <ShareButtons
        title={d.title}
        description={d.description}
      />
    </div>

    <AdSlot placement="article" />

    <div class="story-footer-card">
      <div class="story-footer-card__main">
        <span class="eyebrow">{d.category === 'known-issue' ? 'Known Issue' : 'Long Press'}</span>
        <h3 class="story-footer-card__name">Swami Guru</h3>
        <p class="story-footer-card__bio">
          {d.category === 'known-issue'
            ? "Swami's column on the things that stay broken. Eleven years leading product at Cond\u00e9 Nast and Newsweek before this."
            : 'Eleven years leading product at Cond\u00e9 Nast and Newsweek. Now writing Long Press from Bengaluru.'}
        </p>
      </div>
      <div class="story-footer-card__actions">
        {d.category === 'known-issue' ? (
          <a href="/known-issue" class="chip chip--primary">More Known Issue Opinions &rarr;</a>
        ) : (
          <a href="/daily" class="chip chip--primary">Read Today's Brief &rarr;</a>
        )}
        <a href="/about" class="chip chip--secondary">About Swami</a>
      </div>
    </div>

    {d.topics.length > 0 && (
      <nav class="chips" aria-label="Topics">
        {d.topics.map((t) => <a class="chip" href={`/topics/${t}`}>#{t}</a>)}
      </nav>
    )}

    <RelatedArticles
      currentSlug={d.slug}
      currentCategory={d.category}
      currentTopics={d.topics}
    />
  </article>
</BaseLayout>

<style>
  /* ============================================================
     Known Issue structure — the column's four tenets, rendered.
     Not today's news (kicker) / Plain about the money (callout) /
     The operator's read (pull-quote) / A verdict (badge).
     Scoped to the story page only.
     ============================================================ */
  .column-trigger {
    margin: var(--s4) 0 0;
    max-width: var(--measure);
    font-size: 14.5px;
    font-style: italic;
    line-height: 1.55;
    color: var(--muted);
  }
  .column-trigger__label {
    display: inline-block;
    margin-right: 8px;
    padding: 2px 9px;
    background: var(--surface);
    border: 1px solid var(--rule);
    font-family: var(--mono);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-style: normal;
    color: var(--ink-soft);
    vertical-align: middle;
  }

  .column-structure {
    display: flex;
    flex-direction: column;
    gap: var(--s5);
    margin-top: var(--s6);
  }

  .column-callout {
    padding: var(--s5);
    background: var(--surface);
    border: 1.5px solid var(--rule);
  }
  .column-callout--money {
    background: var(--accent-2-subtle);
    border-color: rgba(62, 124, 116, 0.35);
  }
  .column-callout__label {
    display: inline-block;
    margin-bottom: 10px;
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent-2);
  }
  .column-callout p {
    margin: 0;
    font-size: 16px;
    line-height: 1.62;
    color: var(--ink);
    max-width: var(--measure);
  }

  .column-pullquote {
    padding: var(--s5) var(--s5);
    border-left: 4px solid var(--ink-soft);
    background: var(--surface);
  }
  .column-pullquote__label {
    display: inline-block;
    margin-bottom: 10px;
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .column-pullquote p {
    margin: 0;
    font-style: italic;
    font-size: 1.08em;
    line-height: 1.6;
    color: var(--ink-soft);
    max-width: var(--measure);
  }

  .column-verdict {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    padding: var(--s5);
    border: 1.5px solid var(--rule-strong);
    background: var(--ground);
  }
  .column-verdict__badge {
    display: inline-flex;
    align-items: center;
    padding: 7px 18px;
    font-family: var(--mono);
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .column-verdict__badge--buy {
    background: var(--accent-2);
    color: #FFFFFF;
  }
  .column-verdict__badge--wait {
    background: var(--accent);
    color: #111625;
  }
  .column-verdict__badge--skip {
    background: var(--accent-deep);
    color: #FFFFFF;
  }
  .column-verdict__note {
    margin: 0;
    font-size: 16px;
    font-weight: 500;
    line-height: 1.62;
    color: var(--ink);
    max-width: var(--measure);
  }

  @media (max-width: 640px) {
    .column-callout,
    .column-verdict { padding: var(--s4); }
    .column-pullquote { padding: var(--s4); }
  }
</style>
