---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import AdSlot from '../components/AdSlot.astro';
import RelatedArticles from '../components/RelatedArticles.astro';
import ShareButtons from '../components/ShareButtons.astro';
import { getResponsiveImage } from '../lib/images';
import { getArticleReadingTime } from '../lib/readingTime';
import { hostLabel } from '../lib/text/inline.mjs';

export async function getStaticPaths() {
  const stories = await getCollection('stories', ({ data }) => !data.draft);
  // data.slug, never the filename - headlines stay rewritable.
  return stories.map((story) => ({
    params: { slug: story.data.slug },
    props: { story },
  }));
}

const { story } = Astro.props;
const { Content } = await render(story);
const d = story.data;
const long = new Intl.DateTimeFormat('en-IN', { dateStyle: 'long' });
const short = new Intl.DateTimeFormat('en-IN', { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric' });
const readingTime = getArticleReadingTime(story);
const leadSrc = d.image ?? d.heroImage ?? (d.category === 'known-issue' ? '/images/fallback/column.png' : '/images/fallback/news.png');
const leadIsSquare = !!d.image;
// heroImage (no square `image` set) renders as a 16:9 crop; give it a
// wide box to match, or the fixed square box crops its sides off.
const leadIsWide = !leadIsSquare && !!d.heroImage;
const lead = getResponsiveImage(leadSrc, { aspectRatio: leadIsSquare || !d.heroImage ? '1/1' : '16/9', customSizes: '(max-width: 759px) 100vw, 46vw' });
const leadAlt = (d.image ? d.imageAlt : d.heroImageAlt) || '';
const leadCaption = d.image ? d.imageCaption : d.heroImageCaption;
---
<BaseLayout
  title={d.title}
  description={d.description}
  schema="NewsArticle"
  published={d.published}
  updated={d.updated}
  image={d.heroImage || d.image}
  wide
>
  <div class={`pg ${d.category === 'known-issue' ? 'pg--ki' : 'pg--daily'} pg--article`}>
  <article>
    <nav class="article-breadcrumb" aria-label="Breadcrumb">
      <a href="/">&larr; Front Page</a>
      <span class="article-breadcrumb__sep">/</span>
      {d.category === 'known-issue' ? (
        <a href="/known-issue" class="article-breadcrumb__curr" style="color: inherit; text-decoration: underline;">Known Issue &middot; Opinion</a>
      ) : (
        <span class="article-breadcrumb__curr">{d.category.replace(/-/g, ' ')}</span>
      )}
    </nav>

    <div class="page-head page-head--article page-head--pillar" style="margin-top: var(--s3);">
      <div class={`art-head${leadSrc ? ' art-head--media' : ''}`}>
        <div class="art-head__text">
          <span class="eyebrow" data-category={d.category}>{d.category === 'known-issue' ? 'Known Issue \u00b7 Opinion' : d.category.replace(/-/g, ' ')}</span>
          <h1>{d.title}</h1>
          <p class="standfirst">{d.description}</p>
          {d.trigger && (
            <p class="column-trigger">
              <span class="column-trigger__label">Not today&rsquo;s news</span>
              {d.trigger}
            </p>
          )}
          <div class="byline">
            <span class="byline__mark"><img src="/images/about/swami-headshot.jpg" alt="" width="38" height="38" loading="lazy" decoding="async" /></span>
            <span class="byline__who">
              <strong class="byline__name">{d.author}</strong>
              <span class="byline__date">
                <time datetime={d.published.toISOString()}>{short.format(d.published)}</time>
                {d.updated && <> &middot; <time datetime={d.updated.toISOString()}>Updated {short.format(d.updated)}</time></>}
              </span>
            </span>
            <span class="byline__read">{readingTime.text}</span>
          </div>
          <ShareButtons
            title={d.title}
            description={d.description}
            compact
            class="share-bar--top"
          />
        </div>
        {leadSrc && (
          <figure class={`art-head__media${leadIsWide ? ' art-head__media--wide' : ''}`}>
            <img src={lead.src} srcset={lead.srcset} sizes={lead.sizes} width={lead.width} height={lead.height} alt={leadAlt} loading="eager" fetchpriority="high" decoding="async" id="article-lead-image" />
            {leadCaption && <figcaption>{leadCaption}</figcaption>}
          </figure>
        )}
      </div>
    </div>

    <div class="prose"><Content /></div>

    {d.sources && d.sources.length > 0 && (
      <p class="brief__source">
        <span class="brief__source-label">Sources</span>
        {d.sources.map((s) => (
          <a href={s.url} rel="noopener" target="_blank" class="brief__source-link">
            {s.label || hostLabel(s.url)} &nearr;
          </a>
        ))}
      </p>
    )}

    {(d.whoBenefits || d.operatorsRead || d.verdict) && (
      <div class="column-structure" aria-label="Known Issue analysis">
        {d.whoBenefits && (
          <div class="column-callout column-callout--money">
            <span class="column-callout__label">
              <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="12" cy="12" r="8.5"></circle><path d="M12 7v10M9 9.5c0-1.1 1.3-2 3-2s3 .9 3 2-1.3 1.7-3 2-3 .9-3 2 1.3 2 3 2 3-.9 3-2"></path></svg>
              Plain about the money
            </span>
            <p>{d.whoBenefits}</p>
            <span class="column-structure__mark" aria-hidden="true">01</span>
          </div>
        )}
        {d.operatorsRead && (
          <div class="column-pullquote">
            <span class="column-pullquote__mark" aria-hidden="true">&ldquo;</span>
            <span class="column-pullquote__label">The operator&rsquo;s read</span>
            <p>{d.operatorsRead}</p>
            <span class="column-structure__mark" aria-hidden="true">02</span>
          </div>
        )}
        {d.verdict && (
          <div class="column-verdict">
            <div class={`column-verdict__stamp column-verdict__stamp--${d.verdict}`}>
              <span class="column-verdict__ring" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="15" height="15"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2"></circle><circle cx="12" cy="12" r="3" fill="currentColor"></circle></svg>
              </span>
              <span class="column-verdict__badge">{d.verdict}</span>
            </div>
            {d.verdictNote && <p class="column-verdict__note">{d.verdictNote}</p>}
          </div>
        )}
      </div>
    )}

    <div class="article-share-end" style="margin-top: var(--s6); margin-bottom: var(--s6); padding-top: var(--s5); border-top: 1px solid var(--rule);">
      <ShareButtons
        title={d.title}
        description={d.description}
      />
    </div>

    <AdSlot placement="article" />

    <div class="story-footer-card">
      <div class="story-footer-card__main">
        <span class="eyebrow">{d.category === 'known-issue' ? 'Known Issue' : 'Long Press'}</span>
        <h3 class="story-footer-card__name">Swami Guru</h3>
        <p class="story-footer-card__bio">
          {d.category === 'known-issue'
            ? "Swami's column on the things that stay broken. Eleven years leading product at Cond\u00e9 Nast and Newsweek before this."
            : 'Eleven years leading product at Cond\u00e9 Nast and Newsweek. Now writing Long Press from Bengaluru.'}
        </p>
      </div>
      <div class="story-footer-card__actions">
        {d.category === 'known-issue' ? (
          <a href="/known-issue" class="chip chip--primary">More Known Issue Opinions &rarr;</a>
        ) : (
          <a href="/daily" class="chip chip--primary">Read Today's Brief &rarr;</a>
        )}
        <a href="/about" class="chip chip--secondary">About Swami</a>
      </div>
    </div>

    {d.topics.length > 0 && (
      <nav class="chips" aria-label="Topics">
        {d.topics.map((t) => <a class="chip" href={`/topics/${t}`}>#{t}</a>)}
      </nav>
    )}

    <RelatedArticles
      currentSlug={d.slug}
      currentCategory={d.category}
      currentTopics={d.topics}
    />
  </article>
  </div>
</BaseLayout>

<style>
  /* ============================================================
     Known Issue structure — the column's four tenets, rendered.
     Not today's news (kicker) / Plain about the money (callout) /
     The operator's read (pull-quote) / A verdict (badge).
     Scoped to the story page only.
     ============================================================ */
  .column-trigger {
    margin: var(--s4) 0 0;
    max-width: var(--measure);
    font-size: 14.5px;
    font-style: italic;
    line-height: 1.55;
    color: var(--muted);
  }
  .column-trigger__label {
    display: inline-block;
    margin-right: 8px;
    padding: 2px 9px;
    background: var(--surface);
    border: 1px solid var(--rule);
    font-family: var(--mono);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-style: normal;
    color: var(--ink-soft);
    vertical-align: middle;
  }

  /* ============================================================
     Known Issue structure v2: a dossier, not a form -- each block
     carries its own color, a ghost index number, and a distinct
     shape so the four-part read scans at a glance.
     ============================================================ */
  .column-structure {
    display: flex;
    flex-direction: column;
    gap: 18px;
    margin-top: var(--s6);
  }

  .column-structure__mark {
    position: absolute;
    right: 14px;
    bottom: 6px;
    font-family: var(--display);
    font-variation-settings: "wdth" 118;
    font-weight: 800;
    font-size: 56px;
    line-height: 1;
    color: var(--ink);
    opacity: 0.06;
    pointer-events: none;
    user-select: none;
  }

  .column-callout {
    position: relative;
    overflow: hidden;
    padding: 20px 22px;
    background: var(--accent-2-subtle);
    border: 2px solid var(--accent-2);
    box-shadow: 4px 4px 0 0 rgba(62, 124, 116, 0.22);
  }
  .column-callout__label {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin-bottom: 10px;
    padding: 4px 10px;
    background: var(--accent-2);
    font-family: var(--mono);
    font-size: 10.5px;
    font-weight: 800;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: #FFFFFF;
  }
  .column-callout p {
    position: relative;
    z-index: 1;
    margin: 0;
    font-size: 16px;
    line-height: 1.62;
    color: var(--ink);
    max-width: var(--measure);
  }

  .column-pullquote {
    position: relative;
    overflow: hidden;
    padding: 22px 26px 22px 30px;
    border: 2px solid var(--ink);
    border-left: 8px solid var(--ink);
    background: var(--surface);
  }
  .column-pullquote__mark {
    position: absolute;
    top: -18px;
    left: 8px;
    font-family: var(--display);
    font-size: 100px;
    line-height: 1;
    color: var(--ink);
    opacity: 0.08;
    pointer-events: none;
  }
  .column-pullquote__label {
    position: relative;
    z-index: 1;
    display: inline-block;
    margin-bottom: 10px;
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .column-pullquote p {
    position: relative;
    z-index: 1;
    margin: 0;
    font-style: italic;
    font-size: 1.08em;
    line-height: 1.6;
    color: var(--ink-soft);
    max-width: var(--measure);
  }

  .column-verdict {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 18px;
    padding: 18px 22px;
    border: 2px dashed var(--rule-strong);
    background: var(--ground);
  }
  .column-verdict__stamp {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
    padding: 9px 20px 9px 14px;
    border: 3px solid currentColor;
    border-radius: 999px;
    transform: rotate(-3deg);
    box-shadow: 3px 3px 0 0 currentColor;
  }
  .column-verdict__ring { display: inline-flex; }
  .column-verdict__badge {
    font-family: var(--mono);
    font-size: 14px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .column-verdict__stamp--buy { color: var(--accent-2); }
  .column-verdict__stamp--wait { color: var(--accent-deep); }
  .column-verdict__stamp--skip { color: #B3261E; }
  .column-verdict__note {
    flex: 1 1 220px;
    margin: 0;
    font-size: 16px;
    font-weight: 500;
    line-height: 1.55;
    color: var(--ink);
    max-width: var(--measure);
  }

  html[data-theme="dark"] .column-callout { background: rgba(62, 124, 116, 0.16); }
  html[data-theme="dark"] .column-pullquote { border-color: var(--dark-rule, #3A3B5C); border-left-color: var(--teal-light); }
  html[data-theme="dark"] .column-verdict__stamp--skip { color: #FF6B5E; }

  @media (max-width: 640px) {
    .column-callout,
    .column-pullquote { padding: 16px 18px; }
    .column-callout { border-left-width: 2px; }
    .column-pullquote { border-left-width: 6px; padding-left: 22px; }
    .column-verdict { padding: 14px 16px; gap: 14px; }
    .column-structure__mark { font-size: 42px; right: 10px; }
  }
</style>
