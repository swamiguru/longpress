---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdSlot from '../../components/AdSlot.astro';
import ResponsiveImage from '../../components/ResponsiveImage.astro';
import { getArticleReadingTime } from '../../lib/readingTime';

// 1. Fetch all column pieces and analyses unified in reverse chronological order
const allStories = (await getCollection('stories', ({ data }) => !data.draft))
  .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());

const leadStory = allStories[0];
const feedStories = allStories.slice(1);

// Topic aggregates for filtering -- counted against feedStories (the list
// the filter pills actually toggle), not allStories, so a count next to a
// pill matches what clicking it will show. The lead piece stays visible
// regardless of filter selection, so it's excluded from both.
const topicCounts: Record<string, number> = {};
for (const s of feedStories) {
  for (const t of s.data.topics || []) {
    topicCounts[t] = (topicCounts[t] || 0) + 1;
  }
}
const topTopics = Object.entries(topicCounts)
  .sort((a, b) => b[1] - a[1])
  .slice(0, 8);

const long = new Intl.DateTimeFormat('en-IN', { dateStyle: 'long' });
---
<BaseLayout
  title="Known Issue — the column on what stays broken"
  description="Swami's column on the things in Apple, Google, Meta, Android, iOS and everyday apps that have been broken long enough to count as a decision. Not launch reviews."
  wide
>
  <!-- Masthead -->
  <div class="page-head page-head--column" id="known-issue-head">
    <svg class="page-head--column__ring" width="440" height="440" viewBox="0 0 440 440" aria-hidden="true" focusable="false">
      <circle cx="220" cy="220" r="170" fill="none" stroke="currentColor" stroke-width="2"></circle>
      <circle cx="220" cy="220" r="118" fill="none" stroke="currentColor" stroke-width="1.5" stroke-dasharray="8 9"></circle>
      <circle cx="220" cy="220" r="34" fill="currentColor"></circle>
    </svg>
    <span class="eyebrow">The column &middot; By Swami Guru</span>
    <h1>Known Issue</h1>
    <p class="standfirst">
      In software, a known issue is the bug everyone has agreed to live with. This column is about the other kind: the things in Apple, Google, Meta, Android, iOS and the apps you open every day that have been wrong long enough to count as a decision rather than an oversight. The morning brief covers what happened today. This covers what has been true for months and still is.
    </p>
  </div>

  <!-- Lead / Featured Column Piece -->
  {leadStory && (
    <section class="column-section" aria-labelledby="featured-opinion-title">
      <div class="column-section-title">
        <h2 id="featured-opinion-title">Featured Column</h2>
        <span>Lead Opinion Piece</span>
      </div>

      <article class="known-issue-featured" id={`article-${leadStory.data.slug}`}>
        {leadStory.data.image && (
          <div class="known-issue-featured__thumb">
            <ResponsiveImage
              src={leadStory.data.image}
              alt={leadStory.data.imageAlt || ''}
              aspectRatio="1/1"
              sizes="(max-width: 640px) 140px, 220px"
            />
          </div>
        )}
        <div class="known-issue-featured__body">
        <div class="known-issue-featured__eyebrow">
          <span class="pill-tag pill-tag--primary">Lead Opinion</span>
          <span>&middot;</span>
          <time datetime={leadStory.data.published.toISOString()}>{long.format(leadStory.data.published)}</time>
          <span>&middot;</span>
          <span>{getArticleReadingTime(leadStory).text}</span>
        </div>

        <h3 class="known-issue-featured__title">
          <a href={`/${leadStory.data.slug}`}>{leadStory.data.title}</a>
        </h3>

        <p class="known-issue-featured__desc">{leadStory.data.description}</p>

        <div class="entry__footer" style="margin-top: var(--s4); padding-top: var(--s3); border-top: 1px solid var(--rule);">
          <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
            <span class="pill-tag pill-tag--known-issue">Known Issue &middot; Opinion</span>
            {leadStory.data.topics.slice(0, 3).map((t) => (
              <span class="pill-tag pill-tag--muted" style="font-size: 10px; text-transform: uppercase;">
                {t}
              </span>
            ))}
          </div>

          <div class="entry__actions">
            <button
              type="button"
              class="card-share-btn"
              data-share-title={`${leadStory.data.title} — Known Issue Opinion by Swami Guru`}
              data-share-url={`/${leadStory.data.slug}`}
              data-share-desc={leadStory.data.description}
              aria-label={`Share ${leadStory.data.title}`}
              title="Share article"
            >
              <svg class="card-share-btn__icon card-share-btn__icon--share" viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="18" cy="5" r="3"></circle>
                <circle cx="6" cy="12" r="3"></circle>
                <circle cx="18" cy="19" r="3"></circle>
                <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
                <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
              </svg>
              <svg class="card-share-btn__icon card-share-btn__icon--check" viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M20 6L9 17l-5-5"></path>
              </svg>
              <span class="card-share-btn__text">Share</span>
            </button>

            <a href={`/${leadStory.data.slug}`} class="entry__cta" style="font-weight: 700;">
              Read Opinion &rarr;
            </a>
          </div>
        </div>
        </div>
      </article>
    </section>
  )}

  <!-- Editorial Tenets — compact, sits after the lead so real content leads -->
  <div class="column-manifesto column-manifesto--compact" aria-label="Editorial Principles">
    <div class="column-manifesto__card">
      <span class="column-manifesto__num">01 / The trigger</span>
      <h3>Not today&rsquo;s news</h3>
      <p>The brief is set off by something that happened this morning. A column is set off by something that has been true for months.</p>
    </div>
    <div class="column-manifesto__card">
      <span class="column-manifesto__num">02 / The money</span>
      <h3>Plain about the money</h3>
      <p>Who benefits from the thing staying broken is usually the answer, and usually the part nobody prints.</p>
    </div>
    <div class="column-manifesto__card">
      <span class="column-manifesto__num">03 / The read</span>
      <h3>The operator&rsquo;s read</h3>
      <p>Eleven years leading product inside large publishers, which is mostly an education in why obvious fixes do not ship.</p>
    </div>
    <div class="column-manifesto__card">
      <span class="column-manifesto__num">04 / The ending</span>
      <h3>A verdict</h3>
      <p>Buy it, skip it, or wait. Not &ldquo;it depends&rdquo;.</p>
    </div>
  </div>

  <!-- Ad Slot -->
  <AdSlot placement="hub" />

  <!-- Unified Column Feed -->
  <section class="column-section" id="all-columns-section" aria-labelledby="all-columns-title" style="margin-top: var(--s7);">
    <div class="column-section-title">
      <h2 id="all-columns-title">Every column ({allStories.length})</h2>
      <span>Newest first</span>
    </div>

    {allStories.length === 0 && (
      <p class="standfirst" style="margin: var(--s4) 0 var(--s6);">
        Nothing here yet. The column starts when there is something worth saying
        that today&rsquo;s news did not already say. The morning brief runs every
        day in the meantime.
      </p>
    )}

    <ul class="archive-row-list" id="column-feed-list">
      {feedStories.map((p) => (
        <li
          class="archive-row"
          id={`story-${p.data.slug}`}
          data-topics={(p.data.topics || []).join(' ')}
        >
          {p.data.image ? (
            <div class="archive-row__thumb">
              <ResponsiveImage
                src={p.data.image}
                alt={p.data.imageAlt || ''}
                aspectRatio="1/1"
                sizes="84px"
              />
            </div>
          ) : (
            <div class="archive-row__thumb--empty" aria-hidden="true">No card</div>
          )}
          <div class="archive-row__body">
            <div class="archive-row__meta-row">
              <div class="archive-row__date">
                <time class="dateline entry__meta" datetime={p.data.published.toISOString()}>
                  {long.format(p.data.published)}
                </time>
                <span class="entry__reading-time">{getArticleReadingTime(p).text}</span>
              </div>
              <a href={`/${p.data.slug}`} class="entry__cta">Read Piece &rarr;</a>
            </div>

            <h3 class="archive-row__title">
              <a href={`/${p.data.slug}`}>{p.data.title}</a>
            </h3>

            <p class="archive-row__desc">{p.data.description}</p>

            <div class="archive-row__tags">
              <span class="pill-tag pill-tag--known-issue" style="font-size: 9.5px;">Known Issue</span>
              {(p.data.topics || []).slice(0, 3).map((tag) => (
                <span class="pill-tag pill-tag--muted" style="font-size: 9.5px; text-transform: uppercase;">
                  {tag}
                </span>
              ))}
            </div>
          </div>
        </li>
      ))}
    </ul>

    <!-- Browse by topic -- moved below the list on purpose: it filters what's
         already on the page rather than loading anything new, so it reads
         as an exit once you're done, the same spot /daily's Volume
         Navigator moved to. -->
    {topTopics.length > 0 && (
      <div class="archive-filter-pills" role="tablist" aria-label="Filter columns by topic" style="margin-top: var(--s6);">
        <button
          type="button"
          class="archive-filter-btn is-active"
          data-filter="all"
          id="btn-filter-all"
        >
          <span>All</span>
          <span class="badge-count">{feedStories.length}</span>
        </button>
        {topTopics.map(([tag, count]) => (
          <button
            type="button"
            class="archive-filter-btn"
            data-filter={tag}
            id={`btn-filter-${tag}`}
          >
            <span style="text-transform: capitalize;">{tag}</span>
            <span class="badge-count">{count}</span>
          </button>
        ))}
      </div>
    )}
  </section>

  <!-- Confidential Tips / Topic Proposal Callout -->
  <div class="column-tip-box" id="tips-box">
    <h3>Know something that stays broken?</h3>
    <p>
      Something in a product you use that has been wrong for years and nobody will say so? That is the column. Send it, in confidence if you prefer, to <a href="mailto:builtbyswami@gmail.com">builtbyswami@gmail.com</a>.
    </p>
  </div>
</BaseLayout>

<script>
  // Interactive Topic Filter for the Unified Column Feed
  (function() {
    const filterButtons = document.querySelectorAll('.archive-filter-btn');
    const feedList = document.getElementById('column-feed-list');
    if (!feedList || !filterButtons.length) return;

    const items = feedList.querySelectorAll('li[data-topics]');

    filterButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-filter');
        if (!filter) return;

        // Update active class
        filterButtons.forEach(b => b.classList.remove('is-active'));
        btn.classList.add('is-active');

        // Filter list items
        items.forEach(item => {
          if (filter === 'all') {
            (item as HTMLElement).style.display = '';
          } else {
            const itemTopics = (item.getAttribute('data-topics') || '').toLowerCase().split(' ');
            if (itemTopics.includes(filter.toLowerCase())) {
              (item as HTMLElement).style.display = '';
            } else {
              (item as HTMLElement).style.display = 'none';
            }
          }
        });
      });
    });
  })();
</script>
