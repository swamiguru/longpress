---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import AdSlot from '../components/AdSlot.astro';
import WhatsAppCta from '../components/WhatsAppCta.astro';
import { getResponsiveImage } from '../lib/images';
import { getArticleReadingTime } from '../lib/readingTime';
import { stripLinks } from '../lib/text/inline.mjs';
import { fpPlain, FP_STATUS } from '../lib/text/finePrint';

const briefs = (await getCollection('daily', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const today = briefs[0];
const archive = briefs.slice(1, 5);

const allStories = (await getCollection('stories', ({ data }) => !data.draft))
  .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());
const featured = allStories[0];
const earlier = allStories.slice(1, 6);

// Fine Print: newest first; same-day pieces fall back to the most recently checked.
const finePrint = (await getCollection('finePrint', ({ data }) => !data.draft))
  .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf() || b.data.lastChecked.valueOf() - a.data.lastChecked.valueOf());
const fpLead = finePrint[0];
const fpRsRow = fpLead?.data.costs?.rows.find((r) => r.highlight) ?? fpLead?.data.costs?.rows[0];
const fpRs = fpRsRow && fpRsRow.amount.length <= 14 ? { amount: fpPlain(fpRsRow.amount), item: fpPlain(fpRsRow.item) } : null;
const fpMore = finePrint.slice(1, 5);
const fpLatestCheck = finePrint.reduce<Date | null>((m, f) => (!m || f.data.lastChecked > m ? f.data.lastChecked : m), null);

const med = new Intl.DateTimeFormat('en-IN', { dateStyle: 'medium', timeZone: 'UTC' });
const dayFmt = new Intl.DateTimeFormat('en-IN', { day: '2-digit', timeZone: 'UTC' });
const monFmt = new Intl.DateTimeFormat('en-IN', { month: 'short', timeZone: 'UTC' });
const wdLong = new Intl.DateTimeFormat('en-US', { weekday: 'long', timeZone: 'UTC' });
const wdFmt = new Intl.DateTimeFormat('en-IN', { weekday: 'short', timeZone: 'UTC' });
const path = (b: { id: string }) => `/daily/${b.id.replace(/\.md$/, '')}`;
const label = (k: string) => k.replace(/-/g, ' ');
const OPINION_TAG = ['commentary', 'hot-take', 'myth-buster', 'known-issue'];

/** Short one-line teaser for a brief item that has no dedicated `teaser` field. */
function excerpt(text: string | undefined, max = 150): string {
  if (!text) return '';
  const clean = stripLinks(text).replace(/\s+/g, ' ').trim();
  if (clean.length <= max) return clean;
  const cut = clean.slice(0, max);
  const lastSpace = cut.lastIndexOf(' ');
  return `${cut.slice(0, lastSpace > 0 ? lastSpace : max)}…`;
}

/**
 * Fallback illustrations (public/images/fallback, drawn by scripts/make-fallbacks.mjs).
 * Used whenever a story has no generated illustration: a Gemini timeout or outage,
 * a missing file, or the community poll slot, which never gets one. NEVER the
 * headline-baked card_N, which would print the title twice under the overlay.
 */
const FALLBACK_BY_KIND: Record<string, string> = {
  commentary: 'commentary',
  'hot-take': 'commentary',
  'known-issue': 'commentary',
  'myth-buster': 'myth',
  tip: 'tip',
};
const dayNumber = (d: Date) => Math.floor(d.getTime() / 86_400_000);
function fallbackFor(kind: string, date: Date): string {
  // Community rotates through three images by date, so it never repeats two days running.
  if (kind === 'community') return `/images/fallback/community-${(dayNumber(date) % 3) + 1}.png`;
  return `/images/fallback/${FALLBACK_BY_KIND[kind] ?? 'news'}.png`;
}

const tiles = today
  ? today.data.items.slice(0, 5).map((item, i) => {
      const generated = Boolean(item.image);
      const src = item.image ?? fallbackFor(item.kind, today.data.date);
      const sizes = i === 0 ? '(max-width: 719px) 100vw, 520px' : '(max-width: 719px) 50vw, 256px';
      return { item, generated, img: getResponsiveImage(src, { aspectRatio: '1/1', customSizes: sizes }) };
    })
  : [];
const communityCount = tiles.filter((t) => t.item.kind === 'community').length;
const fallbackCount = tiles.filter((t) => !t.generated && t.item.kind !== 'community').length;
if (today && fallbackCount > 0) {
  console.warn(`[homepage] ${today.id}: ${fallbackCount} of ${tiles.length - communityCount} Daily Five illustrations fell back to a stock illustration`);
}

/** Known Issue image: square illustration, else the 16:9 hero, else the column fallback. */
function kiImage(s: (typeof allStories)[number], sizes: string) {
  if (s.data.image) return getResponsiveImage(s.data.image, { aspectRatio: '1/1', customSizes: sizes });
  if (s.data.heroImage) return getResponsiveImage(s.data.heroImage, { aspectRatio: '16/9', customSizes: sizes });
  return getResponsiveImage('/images/fallback/column.png', { aspectRatio: '1/1', customSizes: sizes });
}
const reportedOn = featured?.data.reportedOn ?? null;
const reportedISO = reportedOn ? reportedOn.toISOString().slice(0, 10) : '';
const daysOpen = reportedOn ? Math.floor((Date.now() - reportedOn.getTime()) / 86_400_000) : null;
const featuredImg = featured ? kiImage(featured, '(max-width: 719px) 100vw, 600px') : null;
const yearsOpen = featured?.data.openSince ? new Date().getFullYear() - featured.data.openSince : null;
import '../styles/home-daily.css';
import '../styles/landing-heads.css';
---
<BaseLayout
  title="Long Press - five tech stories every morning, with an honest take"
  description="Five tech stories every morning in The Daily Five, Known Issue on what stays broken, and Fine Print explainers on India's rules and prices."
  bare
  wide
>
<div class="hp">
  <h1 class="hp-h1">Long Press: five tech stories every morning</h1>
  <!-- Mobile only: the nav is behind the hamburger, so keep both doors in reach -->
  <nav class="hp-doors-m" aria-label="Sections">
    <a class="hp-door-m hp-door-m--daily" href={today ? path(today) : '/daily'} id="cta-read-today">The Daily Five &rarr;</a>
    <a class="hp-door-m hp-door-m--ki" href="/known-issue" id="cta-known-issue-door">Known Issue &rarr;</a>
    <a class="hp-door-m hp-door-m--fp" href="/fine-print" id="cta-fine-print-door">Fine Print &rarr;</a>
  </nav>

  <!-- 1. Today's Five -->
  {today && (
    <section class="hp-daily" aria-labelledby="todays-five-heading" id="section-todays-five">
      <div class="hp-ahead">
        <div class="hp-ahead__cal" role="img" aria-label={`Today, ${med.format(today.data.date)}`}>
          <small>{wdFmt.format(today.data.date)}</small>
          <b>{dayFmt.format(today.data.date)}</b>
          <small>{monFmt.format(today.data.date)}</small>
        </div>
        <div class="hp-ahead__main">
          <p class="hp-ahead__new"><i aria-hidden="true"></i><em>New today</em></p>
          <h2 id="todays-five-heading">Today&rsquo;s Five</h2>
          <p class="hp-ahead__sub">Five tech stories every morning, each one taken apart the same way.</p>
          <p class="hp-labels"><b>The problem</b> &middot; <b>What changed</b> &middot; <b>The catch</b> &middot; <b>What it means for you</b></p>
        </div>
        <a href={path(today)} class="hp-btn" id="link-read-full-issue">Read the full issue &rarr;</a>
      </div>

      <ol class="hp-bento" data-count={tiles.length} id="daily-list">
        {tiles.map(({ item, img }, i) => (
          <li class:list={['hp-tile', { 'hp-tile--lead': i === 0 }]} id={`daily-list-slot-${item.slot}`}>
            <a class="hp-tile__a" href={`${path(today)}#story-${item.slot}`}>
              <img
                class="hp-tile__img"
                src={img.src}
                srcset={img.srcset}
                sizes={img.sizes}
                width={img.width}
                height={img.height}
                alt=""
                loading={i === 0 ? 'eager' : 'lazy'}
                fetchpriority={i === 0 ? 'high' : 'auto'}
                decoding="async"
              />
              <span class="hp-tile__scrim" aria-hidden="true"></span>
              <span class="hp-tile__top">
                <span class="hp-tile__num" aria-hidden="true">{String(item.slot).padStart(2, '0')}</span>
                <span class:list={['hp-tag', { 'hp-tag--op': OPINION_TAG.includes(item.kind) }]}>{label(item.kind)}</span>
              </span>
              <div class="hp-tile__tx">
                <h3 class="hp-tile__title">{item.heading}</h3>
                {i === 0 && (
                  <p class="hp-tile__you">
                    <b>What it means for you</b>
                    {excerpt(item.forYou || item.body || item.teaser, 170)}
                  </p>
                )}
              </div>
            </a>
          </li>
        ))}
      </ol>
    </section>
  )}

  {today && <WhatsAppCta variant="strip" location="home_after_five" />}

  <!-- 2. The Daily Five Archive -->
  {archive.length > 0 && (
    <section class="hp-archive" aria-labelledby="heading-daily-archive" id="section-daily-archive">
      <div class="hp-shead">
        <h2 id="heading-daily-archive">The Daily Five Archive</h2>
        <a href="/daily" class="hp-btn" id="link-all-daily-archive">All {briefs.length} issues &rarr;</a>
      </div>
      <ul class="hp-arch" id="daily-archive-grid">
        {archive.map((b) => {
          const briefSlug = b.id.replace(/\.md$/, '');
          return (
            <li id={`brief-${briefSlug}`}>
              <a class="hp-ai" href={path(b)} id={`brief-link-${briefSlug}`}>
                <time class="hp-ai__date" datetime={b.data.date.toISOString()}>
                  <b>{dayFmt.format(b.data.date)}</b>
                  <span>{monFmt.format(b.data.date)} &middot; {wdFmt.format(b.data.date)}</span>
                </time>
                <h3 class="hp-ai__t" id={`brief-title-${briefSlug}`}>{b.data.title}</h3>
                <span class="hp-ai__meta">
                  <span class="hp-pips" aria-hidden="true">{b.data.items.map(() => <i></i>)}</span>
                  {b.data.items.length} stories &middot; {getArticleReadingTime(b).text}
                </span>
              </a>
            </li>
          );
        })}
      </ul>
    </section>
  )}

  <!-- Ad Slot -->
  <AdSlot placement="hub" />

  <!-- 3. Known Issue -->
  {featured && featuredImg && (
    <section class="hp-band" aria-labelledby="heading-known-issue" id="section-known-issue">
      <div class="hp-band__in">
        <div class="hp-shead">
          <div>
            <p class="hp-kick"><i aria-hidden="true"></i>Still open &middot; No schedule</p>
            <h2 id="heading-known-issue">Known Issue</h2>
            <p class="hp-shead__sub">The things in Apple, Google, Meta, Android, iOS and everyday apps that have been broken long enough to count as a decision.</p>
          </div>
          <a href="/known-issue" class="hp-btn" id="link-known-issue-hub">All {allStories.length} columns &rarr;</a>
        </div>

        <div class="hp-ki">
          <a
            href={`/${featured.data.slug}`}
            class="hp-kf"
            id={`known-issue-lead-${featured.data.slug}`}
            aria-labelledby={`known-issue-lead-title-${featured.data.slug}`}
          >
            <div class="hp-kf__img">
              <img
                src={featuredImg.src}
                srcset={featuredImg.srcset}
                sizes={featuredImg.sizes}
                width={featuredImg.width}
                height={featuredImg.height}
                alt=""
                loading="lazy"
                decoding="async"
              />
              <div class="hp-kf__shade" aria-hidden="true"></div>
              <div class="hp-chips">
                <span class="hp-chip hp-chip--f"><i aria-hidden="true"></i>Still open</span>
                {featured.data.trigger && <span class="hp-chip">Not today&rsquo;s news</span>}
              </div>
              {daysOpen && daysOpen > 0 ? (
                <div class="hp-years hp-years--days"><b data-open-since={reportedISO}>{daysOpen.toLocaleString('en-US')}</b><span>Days open since {med.format(featured.data.reportedOn)}</span></div>
              ) : yearsOpen && yearsOpen > 0 ? (
                <div class="hp-years"><b>{yearsOpen}</b><span>Years since {featured.data.openSince}</span></div>
              ) : null}
            </div>
            <div class="hp-kf__body">
              <h3 id={`known-issue-lead-title-${featured.data.slug}`} class="hp-kf__title">{featured.data.title}</h3>
              <p class="hp-kf__desc">{featured.data.description}</p>
              <div class="hp-kf__foot">
                <span>
                  <time datetime={featured.data.published.toISOString()}>{med.format(featured.data.published)}</time>
                  &middot; {getArticleReadingTime(featured).text}
                </span>
                <b id="cta-read-lead-opinion">Read opinion &rarr;</b>
              </div>
            </div>
          </a>

          {earlier.length > 0 && (
            <div class="hp-ke">
              <h3 class="hp-ke__label">Earlier</h3>
              <ol id="known-issue-index">
                {earlier.map((s) => {
                  const thumb = kiImage(s, '84px');
                  return (
                    <li class="hp-kr" id={`story-${s.data.slug}`}>
                      <time class="hp-kd" datetime={s.data.published.toISOString()}>
                        <b>{dayFmt.format(s.data.published)}</b>{monFmt.format(s.data.published)}
                      </time>
                      <div>
                        <h3 class="hp-kr__t">
                          <a class="hp-kr__a" href={`/${s.data.slug}`} id={`story-title-${s.data.slug}`}>{s.data.title}</a>
                        </h3>
                        {s.data.topics && s.data.topics.length > 0 && (
                          <p class="hp-kr__tags">{s.data.topics.slice(0, 2).map((t: string) => `#${t}`).join(' ')}</p>
                        )}
                      </div>
                      <div class="hp-kt" aria-hidden="true">
                        <img
                          src={thumb.src}
                          srcset={thumb.srcset}
                          sizes={thumb.sizes}
                          width={thumb.width}
                          height={thumb.height}
                          alt=""
                          loading="lazy"
                          decoding="async"
                        />
                      </div>
                    </li>
                  );
                })}
              </ol>
            </div>
          )}
        </div>
      </div>
    </section>
  )}

  <!-- 4. Fine Print -->
  {fpLead && (
    <section class="hp-fp" aria-labelledby="heading-fine-print" id="section-fine-print">
      <div class="hp-fp__in">
        <div class="hp-shead">
          <div>
            <p class="hp-kick hp-fp__kick">
              <svg width="13" height="13" viewBox="0 0 40 40" aria-hidden="true"><g stroke="currentColor" stroke-width="6" stroke-linecap="round"><line x1="20" y1="5" x2="20" y2="35"></line><line x1="7" y1="12.5" x2="33" y2="27.5"></line><line x1="7" y1="27.5" x2="33" y2="12.5"></line></g></svg>
              Explainers{fpLatestCheck && <> &middot; Last checked {med.format(fpLatestCheck)}</>}
            </p>
            <h2 id="heading-fine-print">Fine Print</h2>
            <p class="hp-shead__sub">The rules, prices and service changes in India that most people skip, read from the source document and worked out in rupees.</p>
          </div>
          <a href="/fine-print" class="hp-btn" id="link-fine-print-hub">All {finePrint.length} explainers &rarr;</a>
        </div>

        <div class="hp-fpg">
          <a href={`/fine-print/${fpLead.data.slug}`} class="hp-fpl" id={`fine-print-lead-${fpLead.data.slug}`}>
            <span class="hp-fpl__meta">
              <span>{fpLead.data.category}</span>
              <span class="hp-fpl__stamp">Last checked {med.format(fpLead.data.lastChecked)}</span>
            </span>
            {fpRs && (
              <span class="hp-fpl__rs"><b>{fpRs.amount}</b><span>{fpRs.item}</span></span>
            )}
            <h3 class="hp-fpl__title">{fpLead.data.title}</h3>
            <p class="hp-fpl__line">{fpPlain(fpLead.data.oneLine)}</p>
            <span class="hp-fpl__check">
              <span class="hp-fpl__checkh">Does this apply to you?</span>
              {fpLead.data.applies.slice(0, 3).map((a) => {
                const st = FP_STATUS[a.status];
                return (
                  <span class="hp-fpl__row">
                    <span class="hp-fpl__who">{a.who}</span>
                    <span class={`hp-fpl__chip hp-fpl__chip--${st.tone}`}>{st.label}</span>
                  </span>
                );
              })}
            </span>
            <b class="hp-fpl__more">Read the explainer &rarr;</b>
          </a>

          {fpMore.length > 0 && (
            <ol class="hp-fpo" id="fine-print-index">
              {fpMore.map((f, i) => (
                <li>
                  <a class="hp-fpo__a" href={`/fine-print/${f.data.slug}`} id={`fine-print-${f.data.slug}`}>
                    <span class="hp-fpo__n" aria-hidden="true">{String(i + 2).padStart(2, '0')}</span>
                    <span class="hp-fpo__tx">
                      <span class="hp-fpo__cat">{f.data.category} &middot; Checked {med.format(f.data.lastChecked)}</span>
                      <span class="hp-fpo__t">{f.data.title}</span>
                    </span>
                  </a>
                </li>
              ))}
            </ol>
          )}
        </div>
      </div>
    </section>
  )}
</div>
<script is:inline>
  (function () {
    var el = document.querySelector('[data-open-since]');
    if (!el) return;
    var p = el.getAttribute('data-open-since').split('-');
    var n = new Date();
    var d = Math.floor((Date.UTC(n.getFullYear(), n.getMonth(), n.getDate()) - Date.UTC(+p[0], +p[1] - 1, +p[2])) / 86400000);
    if (d > 0) el.textContent = d.toLocaleString('en-US');
  })();
</script>
</BaseLayout>
