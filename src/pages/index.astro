---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import AdSlot from '../components/AdSlot.astro';
import ResponsiveImage from '../components/ResponsiveImage.astro';
import { getArticleReadingTime } from '../lib/readingTime';

const briefs = (await getCollection('daily', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const today = briefs[0];
const earlier = briefs.slice(1, 7);

const stories = (await getCollection('stories', ({ data }) => !data.draft))
  .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf())
  .slice(0, 6);
const leadStory = stories[0];
const restStories = stories.slice(1);

const med = new Intl.DateTimeFormat('en-IN', { dateStyle: 'medium' });
const path = (b: { id: string }) => `/daily/${b.id.replace(/\.md$/, '')}`;
const label = (k: string) => k.replace(/-/g, ' ');
const OPINION = ['hot-take', 'myth-buster', 'known-issue'];
const hasOpinionToday = Boolean(today?.data.items.some((i) => OPINION.includes(i.kind)));

/** Short one-line teaser for a brief item that has no dedicated `teaser` field. */
function excerpt(text: string | undefined, max = 130): string {
  if (!text) return '';
  const clean = text.replace(/\s+/g, ' ').trim();
  if (clean.length <= max) return clean;
  const cut = clean.slice(0, max);
  const lastSpace = cut.lastIndexOf(' ');
  return `${cut.slice(0, lastSpace > 0 ? lastSpace : max)}\u2026`;
}
---
<BaseLayout
  title="Long Press - five tech stories every morning, with an honest take"
  description="Press and hold. Five tech stories every morning at 10:00 IST in The Daily Five, plus Known Issue, Swami's column on the things that stay broken."
  bare
  wide
>
  <!-- Hero: intro + today's issue preview -->
  <div class="hero-grid" id="homepage-hero">
    <div class="hero-intro">
      <span class="eyebrow">The Daily Five &middot; Latest issue</span>
      <h1 class="page-head__title">Press and hold.</h1>
      <p class="standfirst">
        Everyone else tells you what happened. We stay on it a beat longer &mdash;
        five stories every morning, with an honest take on which ones actually matter.
      </p>
      {today && (
        <div class="hero-intro__actions">
          <a href={path(today)} class="chip chip--primary chip--pill" id="cta-read-today">
            Read Today&rsquo;s Brief &rarr;
          </a>
          <a href="/daily" class="chip chip--secondary chip--pill" id="cta-all-issues">
            All Issues ({briefs.length})
          </a>
        </div>
      )}
    </div>

    {today && (
      <a href={path(today)} class="hero-preview" id="today-hero-preview" aria-labelledby="today-hero-preview-title">
        <span class="hero-preview__eyebrow">Today&rsquo;s issue &middot; {med.format(today.data.date)}</span>
        <h2 id="today-hero-preview-title" class="hero-preview__title">{today.data.title}</h2>
        <p class="hero-preview__desc">{today.data.description}</p>
        <div class="hero-preview__tags">
          {hasOpinionToday && <span class="hero-preview__tag hero-preview__tag--accent">Hot take inside</span>}
          <span class="hero-preview__tag">{today.data.items.length} items &middot; {getArticleReadingTime(today).text}</span>
        </div>
      </a>
    )}
  </div>

  <!-- 1. Today's Five — every item in this morning's brief, as a real list -->
  {today && (
    <section class="section" aria-labelledby="todays-five-heading" id="section-todays-five">
      <div class="column-section-title">
        <h2 id="todays-five-heading">Today&rsquo;s Five</h2>
        <a href={path(today)} class="section__link-pill" id="link-read-full-issue">
          <span>Read the full issue &rarr;</span>
        </a>
      </div>
      <ol class="daily-list">
        {today.data.items.map((item) => (
          <li class="daily-list__item" id={`daily-list-slot-${item.slot}`}>
            <span class="brief__num" aria-hidden="true">{String(item.slot).padStart(2, '0')}</span>
            <div>
              <span class="eyebrow brief__kind">{label(item.kind)}</span>
              <h3><a href={`${path(today)}#story-${item.slot}`}>{item.heading}</a></h3>
              <p class="daily-list__teaser">{excerpt(item.body || item.teaser)}</p>
            </div>
            {item.image && (
              <a
                href={`${path(today)}#story-${item.slot}`}
                class="daily-list__thumb"
                aria-hidden="true"
                tabindex="-1"
              >
                <ResponsiveImage
                  src={item.image}
                  alt=""
                  aspectRatio="1/1"
                  sizes="96px"
                />
              </a>
            )}
          </li>
        ))}
      </ol>
    </section>
  )}

  <!-- Ad Slot -->
  <AdSlot placement="hub" />

  <!-- 2. Known Issue — The Standing Opinion Column -->
  {stories.length > 0 && (
    <section class="section" aria-labelledby="heading-known-issue" id="section-known-issue">
      <div class="section__head">
        <div>
          <span class="section__eyebrow">The column</span>
          <h2 id="heading-known-issue">Known Issue</h2>
          <p class="section__sub">The things in Apple, Google, Meta, Android, iOS and everyday apps that have been broken long enough to count as a decision.</p>
        </div>
        <a href="/known-issue" class="section__link-pill" id="link-known-issue-hub">
          <span>Every column ({stories.length}) &rarr;</span>
        </a>
      </div>

      {leadStory && (
        <a
          href={`/${leadStory.data.slug}`}
          class="known-issue-lead"
          id={`known-issue-lead-${leadStory.data.slug}`}
          aria-labelledby={`known-issue-lead-title-${leadStory.data.slug}`}
        >
          <div class="known-issue-lead__body">
            <div class="known-issue-lead__eyebrow">
              <span>Known Issue &middot; Opinion</span>
              <span aria-hidden="true">&middot;</span>
              <time datetime={leadStory.data.published.toISOString()}>{med.format(leadStory.data.published)}</time>
              <span aria-hidden="true">&middot;</span>
              <span>{getArticleReadingTime(leadStory).text}</span>
            </div>

            {leadStory.data.trigger && (
              <p class="known-issue-lead__trigger">
                <span class="known-issue-lead__trigger-label">Not today&rsquo;s news</span>
                {leadStory.data.trigger}
              </p>
            )}

            <h3 id={`known-issue-lead-title-${leadStory.data.slug}`} class="known-issue-lead__title">{leadStory.data.title}</h3>
            <p class="known-issue-lead__desc">{leadStory.data.description}</p>

            <span class="known-issue-lead__cta" id="cta-read-lead-opinion" aria-hidden="true">Read Opinion &rarr;</span>
          </div>

          {leadStory.data.image && (
            <div class="known-issue-lead__thumb">
              <ResponsiveImage
                src={leadStory.data.image}
                alt=""
                aspectRatio="1/1"
                sizes="(max-width: 640px) 110px, 220px"
              />
            </div>
          )}
        </a>
      )}
      {restStories.length > 0 && (
        <ul class="entries" id="known-issue-grid">
          {restStories.map((s) => {
          const reading = getArticleReadingTime(s);
          return (
            <li class="entry-card" id={`story-${s.data.slug}`}>
              {s.data.image && (
                <div class="entry-card__thumb">
                  <ResponsiveImage
                    src={s.data.image}
                    alt=""
                    aspectRatio="1/1"
                    sizes="(max-width: 640px) 100vw, 320px"
                  />
                </div>
              )}
              <div class="entry__meta-row">
                <div style="display: flex; align-items: center; gap: 6px;">
                  <span class="pill-tag pill-tag--known-issue">Known Issue &middot; Opinion</span>
                </div>
                <span class="entry__reading-time">{reading.text}</span>
              </div>
              <h3 class="entry__title">
                <a href={`/${s.data.slug}`} id={`story-title-${s.data.slug}`}>{s.data.title}</a>
              </h3>
              <p class="entry__desc">{s.data.description}</p>
              {s.data.topics && s.data.topics.length > 0 && (
                <div class="entry__topics">
                  {s.data.topics.slice(0, 3).map((t: string) => (
                    <a href={`/topics/${t}`} class="entry__topic-pill">#{t}</a>
                  ))}
                </div>
              )}
              <div class="entry__footer">
                <time class="dateline" datetime={s.data.published.toISOString()}>
                  {med.format(s.data.published)}
                </time>
                <div class="entry__actions">
                  <button
                    type="button"
                    class="card-share-btn"
                    data-share-title={`${s.data.title} — Known Issue Opinion by Swami Guru`}
                    data-share-url={`/${s.data.slug}`}
                    data-share-desc={s.data.description}
                    aria-label={`Share ${s.data.title}`}
                    title="Share article via Web Share API"
                  >
                    <svg class="card-share-btn__icon card-share-btn__icon--share" viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <circle cx="18" cy="5" r="3"></circle>
                      <circle cx="6" cy="12" r="3"></circle>
                      <circle cx="18" cy="19" r="3"></circle>
                      <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
                      <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
                    </svg>
                    <svg class="card-share-btn__icon card-share-btn__icon--check" viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M20 6L9 17l-5-5"/>
                    </svg>
                    <span class="card-share-btn__text">Share</span>
                  </button>
                  <a href={`/${s.data.slug}`} class="entry__cta" id={`story-link-${s.data.slug}`} aria-label={`Read ${s.data.title}`}>
                    Read Piece &rarr;
                  </a>
                </div>
              </div>
            </li>
          );
        })}
        </ul>
      )}

      <div class="known-issue-strip" id="known-issue-desk-callout">
        <div class="known-issue-strip__text">
          <strong>Known Issue Column:</strong>
          <span>The things in Apple, Google, Meta and the apps you use daily that stay broken.</span>
        </div>
        <a href="/known-issue" class="entry__cta" style="font-weight: 700; white-space: nowrap;">
          About the Column &rarr;
        </a>
      </div>
    </section>
  )}

  <!-- 3. The Daily Five Archive — Past Morning Editions -->
  {earlier.length > 0 && (
    <section class="section" aria-labelledby="heading-daily-archive" id="section-daily-archive">
      <div class="section__head">
        <div>
          <span class="section__eyebrow">The morning brief</span>
          <h2 id="heading-daily-archive">The Daily Five Archive</h2>
          <p class="section__sub">Five tech stories every morning at 10:00 IST, each one taken apart the same way: the problem, what changed, the catch, and what it means for you.</p>
        </div>
        <a href="/daily" class="section__link-pill" id="link-all-daily-archive">
          <span>All Issues ({briefs.length}) &rarr;</span>
        </a>
      </div>
      <ul class="entries" id="daily-archive-grid">
        {earlier.map((b) => {
          const reading = getArticleReadingTime(b);
          const briefSlug = b.id.replace(/\.md$/, '');
          const dayOfWeek = new Intl.DateTimeFormat('en-IN', { weekday: 'short' }).format(b.data.date);
          return (
            <li class="entry-card" id={`brief-${briefSlug}`}>
              <div class="entry__meta-row">
                <div style="display: flex; align-items: center; gap: 7px;">
                  <time class="pill-tag pill-tag--date" datetime={b.data.date.toISOString()}>
                    {med.format(b.data.date)}
                  </time>
                  <span class="pill-tag pill-tag--muted" style="font-size: 9.5px; padding: 2px 7px;">
                    {dayOfWeek}
                  </span>
                </div>
                <span class="entry__reading-time">{reading.text}</span>
              </div>
              <h3 class="entry__title">
                <a href={path(b)} id={`brief-title-${briefSlug}`}>{b.data.title}</a>
              </h3>
              <p class="entry__desc">{b.data.description}</p>
              <div class="entry__footer">
                <span class="entry__meta-note">The Daily Five &middot; 5 Stories</span>
                <div style="display: flex; align-items: center; gap: 10px;">
                  <button
                    type="button"
                    class="card-share-btn"
                    data-share-title={`${b.data.title} — Long Press Daily Five`}
                    data-share-url={path(b)}
                    data-share-desc={b.data.description}
                    aria-label={`Share ${b.data.title}`}
                    title="Share brief via Web Share API"
                  >
                    <svg class="card-share-btn__icon card-share-btn__icon--share" viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <circle cx="18" cy="5" r="3"></circle>
                      <circle cx="6" cy="12" r="3"></circle>
                      <circle cx="18" cy="19" r="3"></circle>
                      <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
                      <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
                    </svg>
                    <svg class="card-share-btn__icon card-share-btn__icon--check" viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M20 6L9 17l-5-5"/>
                    </svg>
                    <span class="card-share-btn__text">Share</span>
                  </button>
                  <a href={path(b)} class="entry__cta" id={`brief-link-${briefSlug}`} aria-label={`Read brief from ${med.format(b.data.date)}`}>
                    Read Issue &rarr;
                  </a>
                </div>
              </div>
            </li>
          );
        })}
      </ul>

      <div style="margin-top: var(--s6); text-align: center;">
        <a href="/daily" class="chip chip--secondary chip--pill" style="padding: 12px 24px; font-size: 13.5px; font-weight: 700; display: inline-flex; align-items: center; gap: 8px;" id="cta-view-full-daily-archive">
          <span>Browse All {briefs.length} Issues in The Daily Five Archive</span>
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </section>
  )}
</BaseLayout>
