---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { getArticleReadingTime } from '../../../../lib/readingTime';

export async function getStaticPaths() {
  const briefs = await getCollection('daily', ({ data }) => !data.draft);
  const groups = new Map<string, { year: string; month: string; briefs: typeof briefs }>();
  for (const b of briefs) {
    const year = String(b.data.date.getFullYear());
    const month = String(b.data.date.getMonth() + 1).padStart(2, '0');
    const key = `${year}/${month}`;
    if (!groups.has(key)) groups.set(key, { year, month, briefs: [] });
    groups.get(key)!.briefs.push(b);
  }
  return [...groups.values()].map(({ year, month, briefs }) => ({
    params: { year, month },
    props: { briefs },
  }));
}

const { year, month } = Astro.params;
const { briefs } = Astro.props;
const med = new Intl.DateTimeFormat('en-IN', { dateStyle: 'medium' });
const monthName = new Intl.DateTimeFormat('en-IN', { month: 'long' })
  .format(new Date(Number(year), Number(month) - 1, 1));
---
<BaseLayout
  title={`The Daily Five - ${monthName} ${year}`}
  description={`Long Press briefs from ${monthName} ${year}.`}
>
  <div class="page-head">
    <span class="eyebrow"><a href={`/daily/${year}`}>{year}</a></span>
    <h1>{monthName}</h1>
    <p class="standfirst">{briefs.length} issues.</p>
  </div>

  <ul class="entries">
    {briefs
      .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
      .map((b) => (
        <li>
          <div class="entry__meta-row">
            <time class="dateline entry__meta" datetime={b.data.date.toISOString()}>
              {med.format(b.data.date)}
            </time>
            <span class="entry__reading-time">{getArticleReadingTime(b).text}</span>
          </div>
          <p class="entry__title">
            <a href={`/daily/${b.id.replace(/\.md$/, '')}`}>{b.data.title}</a>
          </p>
        </li>
      ))}
  </ul>
</BaseLayout>
