---
/**
 * Two kinds of page share this two-segment route:
 *   /daily/2026/10     the month archive (DailyMonthArchive)
 *   /daily/2026-10-23/4  the share page for one Daily Five story (DailyStoryShare)
 * They are one file because Astro cannot hold two sibling routes with the same
 * shape. The date-shaped first segment can never collide with a year.
 */
import { getCollection } from 'astro:content';
import DailyMonthArchive from '../../../../components/DailyMonthArchive.astro';
import DailyStoryShare from '../../../../components/DailyStoryShare.astro';

export async function getStaticPaths() {
  const briefs = await getCollection('daily', ({ data }) => !data.draft);
  const groups = new Map<string, { year: string; month: string; briefs: typeof briefs }>();
  for (const b of briefs) {
    const year = String(b.data.date.getFullYear());
    const month = String(b.data.date.getMonth() + 1).padStart(2, '0');
    const key = `${year}/${month}`;
    if (!groups.has(key)) groups.set(key, { year, month, briefs: [] });
    groups.get(key)!.briefs.push(b);
  }
  const sorted = [...groups.values()].sort((a, b) => {
    return `${b.year}/${b.month}`.localeCompare(`${a.year}/${a.month}`);
  });
  const months = sorted.map(({ year, month, briefs }, idx) => ({
    params: { year, month },
    props: {
      kind: 'month' as const,
      year,
      month,
      briefs,
      newerMonth: sorted[idx - 1] ? { year: sorted[idx - 1].year, month: sorted[idx - 1].month } : null,
      olderMonth: sorted[idx + 1] ? { year: sorted[idx + 1].year, month: sorted[idx + 1].month } : null,
      totalMonths: sorted.length,
      currentMonthNum: sorted.length - idx,
    },
  }));
  // One share page per story that lives in the brief. Items promoted to their
  // own page (`story`) are shared at that page instead, so they get none.
  const stories = briefs.flatMap((brief) => {
    const date = brief.id.replace(/\.md$/, '');
    return brief.data.items
      .filter((item) => !item.story)
      .map((item) => ({
        params: { year: date, month: String(item.slot) },
        props: { kind: 'story' as const, brief, date, item, count: brief.data.items.length },
      }));
  });
  return [...months, ...stories];
}

const props = Astro.props;
---
{props.kind === 'story'
  ? <DailyStoryShare brief={props.brief} date={props.date} item={props.item} count={props.count} />
  : <DailyMonthArchive {...props} />}
