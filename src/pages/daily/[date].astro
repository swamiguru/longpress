---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ResponsiveImage from '../../components/ResponsiveImage.astro';
import AdSlot from '../../components/AdSlot.astro';
import ShareButtons from '../../components/ShareButtons.astro';
import { getArticleReadingTime } from '../../lib/readingTime';

export async function getStaticPaths() {
  const briefs = await getCollection('daily', ({ data }) => !data.draft);
  briefs.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
  const total = briefs.length;
  return briefs.map((brief, idx) => ({
    params: { date: brief.id.replace(/\.md$/, '') },
    props: {
      brief,
      totalCount: total,
      prevBrief: briefs[idx + 1] ? {
        dateStr: briefs[idx + 1].id.replace(/\.md$/, ''),
        date: briefs[idx + 1].data.date,
      } : null,
      nextBrief: briefs[idx - 1] ? {
        dateStr: briefs[idx - 1].id.replace(/\.md$/, ''),
        date: briefs[idx - 1].data.date,
      } : null,
    },
  }));
}

const { brief, prevBrief, nextBrief, totalCount } = Astro.props;
const { Content } = await render(brief);
const d = brief.data;
const items = [...d.items].sort((a, b) => a.slot - b.slot);
const OPINION = ['hot-take', 'myth-buster', 'known-issue'];
const label = (k: string) => k.replace(/-/g, ' ');
const long = new Intl.DateTimeFormat('en-IN', { dateStyle: 'full' });
const shortDate = new Intl.DateTimeFormat('en-IN', { day: 'numeric', month: 'short' });
const readingTime = getArticleReadingTime(brief);

/** The press-and-hold structure, in reading order. */
const ANALYSIS = [
  ['problem', 'The problem'],
  ['breakthrough', 'What changed'],
  ['catch', 'The catch'],
  ['forYou', 'What it means for you'],
] as const;
---
<BaseLayout title={d.title} description={d.description} schema="NewsArticle" published={d.date}>
  <article>
    <div class="page-head">
      <span class="eyebrow">The Daily Five</span>
      <h1>{d.title}</h1>
      <div class="article__meta" style="margin-top: var(--s3); margin-bottom: 0;">
        <time class="dateline" datetime={d.date.toISOString()}>{long.format(d.date)}</time>
        <span class="dateline">&middot;</span>
        <span class="dateline reading-time">{readingTime.text}</span>
      </div>
      {d.intro && <p class="standfirst" style="margin-top: var(--s4)">{d.intro}</p>}

      {items.length > 1 && (
        <div class="issue-jump-bar">
          <span class="issue-jump-bar__label">In this issue:</span>
          <nav class="issue-jump-bar__nav" aria-label="Stories in this edition">
            {items.map((item) => (
              <a href={`#story-${item.slot}`} class="issue-jump-pill">
                <span class="issue-jump-pill__num">{String(item.slot).padStart(2, '0')}</span>
                <span class="issue-jump-pill__title">{item.heading}</span>
              </a>
            ))}
          </nav>
        </div>
      )}

      <div style="margin-top: var(--s4);">
        <ShareButtons
          title={d.title}
          description={d.description}
        />
      </div>
    </div>

    <ol class="brief">
      {items.map((item, i) => {
        const analysis = ANALYSIS.filter(([k]) => item[k as keyof typeof item]);
        return (
          <>
            {i === 2 && <li class="ad-row"><AdSlot placement="brief" /></li>}
            <li id={`story-${item.slot}`} class={`brief__item${OPINION.includes(item.kind) ? ' brief__item--opinion' : ''}`}>
              <span id={`slot-${item.slot}`} class="slot-anchor" aria-hidden="true"></span>
              <span id={item.heading.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '')} class="slot-anchor" aria-hidden="true"></span>
              <div class="brief__head">
                <span class="brief__num" aria-hidden="true">{String(item.slot).padStart(2, '0')}</span>
                <div>
                  <span class="eyebrow brief__kind">{label(item.kind)}</span>
                  <h2>{item.heading}</h2>
                </div>
              </div>

              {item.image && (
                <ResponsiveImage
                  src={item.image}
                  alt={item.imageAlt || item.heading}
                  caption={item.imageCaption}
                  aspectRatio="1/1"
                  loading="lazy"
                  figureClass="brief__figure"
                  captionClass="brief__caption"
                  class="brief__card"
                />
              )}

              {item.body && <p class="brief__body">{item.body}</p>}

              {item.story && (
                <>
                  <p class="brief__body">{item.teaser}</p>
                  <p class="brief__more"><a href={`/${item.story}`}>Read the full story &rarr;</a></p>
                </>
              )}

              {analysis.length > 0 && (
                <dl class="analysis" aria-label="Analysis breakdown">
                  {analysis.map(([key, text]) => (
                    <div class={`analysis__cell analysis__cell--${key}`}>
                      <dt class={`analysis__pill analysis__pill--${key}`}>
                        <span class={`pill-dot pill-dot--${key}`} aria-hidden="true" />
                        <span>{text}</span>
                      </dt>
                      <dd>{item[key as keyof typeof item]}</dd>
                    </div>
                  ))}
                </dl>
              )}

              {item.source && (
                <p class="brief__source">
                  <a href={item.source} rel="nofollow noopener" target="_blank" class="brief__source-link">
                    Original Source &nearr;
                  </a>
                </p>
              )}
            </li>
          </>
        );
      })}
    </ol>

    <div class="prose" style="margin-top: var(--s7)"><Content /></div>

    <div class="brief-share-end" style="margin-top: var(--s6); margin-bottom: var(--s6); padding-top: var(--s5); border-top: 1px solid var(--rule);">
      <ShareButtons
        title={d.title}
        description={d.description}
      />
    </div>

    <nav class="edition-nav" aria-label="Edition Navigation">
      <div class="edition-nav__col edition-nav__col--prev">
        {prevBrief ? (
          <a href={`/daily/${prevBrief.dateStr}`} class="edition-nav__link">
            <span class="edition-nav__sub">&larr; Previous Brief</span>
            <span class="edition-nav__title">{shortDate.format(prevBrief.date)}</span>
          </a>
        ) : (
          <span class="edition-nav__disabled">Beginning of archive</span>
        )}
      </div>

      <div class="edition-nav__col edition-nav__col--center">
        <a href="/daily" class="chip chip--secondary">All Issues ({totalCount})</a>
      </div>

      <div class="edition-nav__col edition-nav__col--next">
        {nextBrief ? (
          <a href={`/daily/${nextBrief.dateStr}`} class="edition-nav__link">
            <span class="edition-nav__sub">Next Brief &rarr;</span>
            <span class="edition-nav__title">{shortDate.format(nextBrief.date)}</span>
          </a>
        ) : (
          <span class="edition-nav__disabled">Latest edition</span>
        )}
      </div>
    </nav>
  </article>

  <script is:inline>
    function scrollCurrentHashIntoView() {
      if (!window.location.hash) return;
      const rawId = window.location.hash.slice(1);
      const target = document.getElementById(rawId) ||
        document.getElementById(`story-${rawId}`) ||
        document.getElementById(`slot-${rawId}`);
      if (target) {
        setTimeout(() => {
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }, 60);
      }
    }
    if (document.readyState === 'complete') {
      scrollCurrentHashIntoView();
    } else {
      window.addEventListener('load', scrollCurrentHashIntoView);
    }
    window.addEventListener('hashchange', scrollCurrentHashIntoView);
  </script>
</BaseLayout>

<style>
  /* The roundup's social cards are 1080x1080. Full width would shout louder
     than the headline, so cap them and let the text lead. Width and height are
     on the tag itself, so the box is reserved before the file loads and the
     brief never reflows. */
  .brief__figure {
    margin: 0;
    margin-top: var(--s4, 1rem);
    margin-bottom: var(--s6, 2rem);
    width: 100%;
    max-width: 320px;
  }
  .brief__figure .responsive-image-box {
    border: 1px solid var(--rule, rgba(23, 24, 46, 0.12));
    background: var(--surface, #FFFFFF);
    aspect-ratio: 1 / 1;
    width: 100%;
  }
  .brief__card {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .brief__caption {
    font-family: var(--mono);
    font-size: 11.5px;
    color: var(--muted);
    margin-top: 8px;
    line-height: 1.45;
  }
</style>
