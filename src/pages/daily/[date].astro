---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ResponsiveImage from '../../components/ResponsiveImage.astro';
import AdSlot from '../../components/AdSlot.astro';
import ShareButtons from '../../components/ShareButtons.astro';
import { getArticleReadingTime } from '../../lib/readingTime';
import { getResponsiveImage } from '../../lib/images';
import { fallbackFor } from '../../lib/fallbacks';
import { linkify, stripLinks, hostLabel } from '../../lib/text/inline.mjs';

/** Every link an item cites: the `sources` list plus the legacy single `source`, de-duplicated. */
function sourcesOf(item: { source?: string; sources?: { label?: string; url: string }[] }) {
  const all = [...(item.sources ?? []), ...(item.source ? [{ url: item.source }] : [])];
  const seen = new Set<string>();
  return all.filter((s) => !seen.has(s.url) && seen.add(s.url));
}

export async function getStaticPaths() {
  const briefs = await getCollection('daily', ({ data }) => !data.draft);
  briefs.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
  const total = briefs.length;
  return briefs.map((brief, idx) => ({
    params: { date: brief.id.replace(/\.md$/, '') },
    props: {
      brief,
      totalCount: total,
      prevBrief: briefs[idx + 1] ? {
        dateStr: briefs[idx + 1].id.replace(/\.md$/, ''),
        date: briefs[idx + 1].data.date,
      } : null,
      nextBrief: briefs[idx - 1] ? {
        dateStr: briefs[idx - 1].id.replace(/\.md$/, ''),
        date: briefs[idx - 1].data.date,
      } : null,
    },
  }));
}

const { brief, prevBrief, nextBrief, totalCount } = Astro.props;
const { Content } = await render(brief);
const d = brief.data;
const dateStr = brief.id.replace(/\.md$/, '');
const items = [...d.items].sort((a, b) => a.slot - b.slot);
const OPINION = ['commentary', 'hot-take', 'myth-buster', 'known-issue'];
const label = (k: string) => k.replace(/-/g, ' ');
const long = new Intl.DateTimeFormat('en-IN', { dateStyle: 'full' });
const shortDate = new Intl.DateTimeFormat('en-IN', { day: 'numeric', month: 'short' });
const short = new Intl.DateTimeFormat('en-IN', { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric' });
const readingTime = getArticleReadingTime(brief);

/** The press-and-hold structure, in reading order. */
const ANALYSIS = [
  ['problem', 'The problem'],
  ['breakthrough', 'What changed'],
  ['catch', 'The catch'],
  ['forYou', 'What it means for you'],
] as const;
---
<BaseLayout title={d.title} description={d.description} schema="NewsArticle" published={d.date} wide>
  <div class="pg pg--daily pg--article">
  <article>
    <div class="page-head page-head--pillar page-head--brief">
      <div class="brief-head__text">
        <span class="eyebrow">The Daily Five</span>
        <h1>{d.title}</h1>
        <div class="byline">
          <span class="byline__mark"><img src="/images/about/swami-headshot.jpg" alt="" width="38" height="38" loading="lazy" decoding="async" /></span>
          <span class="byline__who">
            <strong class="byline__name">{d.author}</strong>
            <time class="byline__date" datetime={d.date.toISOString()}>{short.format(d.date)}</time>
          </span>
          <span class="byline__read">{readingTime.text}</span>
        </div>
        {d.intro && <p class="standfirst">{d.intro}</p>}
      </div>

      {items.length > 1 && (
        <div class="issue-jump-bar">
          <span class="issue-jump-bar__label">In this issue</span>
          <nav class="issue-jump-bar__nav" aria-label="Stories in this edition">
            {items.map((item) => (
              <a href={`#story-${item.slot}`} class="issue-jump-pill">
                <span class="issue-jump-pill__num">{String(item.slot).padStart(2, '0')}</span>
                <span class="issue-jump-pill__title">{item.heading}</span>
              </a>
            ))}
          </nav>
        </div>
      )}
    </div>

    <ol class="stories">
      {items.map((item, i) => {
        const analysis = ANALYSIS.filter(([k]) => item[k as keyof typeof item]);
        const img = getResponsiveImage(item.image ?? fallbackFor(item.kind, d.date), {
          aspectRatio: '1/1',
          customSizes: '(max-width: 859px) 100vw, 250px',
        });
        const heading = item.heading;
        return (
          <>
            {i === 2 && <li class="ad-row"><AdSlot placement="brief" /></li>}
            <li id={`story-${item.slot}`} class={`story${OPINION.includes(item.kind) ? ' story--opinion' : ''}`}>
              <span id={`slot-${item.slot}`} class="slot-anchor" aria-hidden="true"></span>
              <span id={heading.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '')} class="slot-anchor" aria-hidden="true"></span>
              <div class="story__grid">
                <div class="story__media">
                  <img
                    class="story__img"
                    src={img.src}
                    srcset={img.srcset}
                    sizes={img.sizes}
                    width={img.width}
                    height={img.height}
                    alt={item.imageAlt || ''}
                    loading={i < 1 ? 'eager' : 'lazy'}
                    decoding="async"
                  />
                  <div class="story__chips">
                    <span class="story__num" aria-hidden="true">{String(item.slot).padStart(2, '0')}</span>
                    <span class="story__kind">{label(item.kind)}</span>
                  </div>
                </div>
                <h2 class="story__title">{heading}</h2>
                <div class="story__body">
                  {item.body && <p class="story__text" set:html={linkify(item.body)} />}
                  {item.story && (
                    <>
                      <p class="story__text" set:html={linkify(item.teaser)} />
                      <p class="brief__more"><a href={`/${item.story}`}>Read the full story &rarr;</a></p>
                    </>
                  )}
                </div>
              </div>

              {analysis.length > 0 && (
                <dl class="analysis" aria-label="Analysis breakdown">
                  {analysis.map(([key, text]) => (
                    <div class={`analysis__cell analysis__cell--${key}`}>
                      <dt class={`analysis__pill analysis__pill--${key}`}>
                        <span class="analysis__icon" aria-hidden="true">
                          {key === 'problem' && (
                            <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3.5 2 20.5h20L12 3.5z"></path><path d="M12 10v4.2"></path><circle cx="12" cy="17.6" r="0.6" fill="currentColor" stroke="none"></circle></svg>
                          )}
                          {key === 'breakthrough' && (
                            <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 0 1 15.3-6.4L21 8"></path><path d="M21 3v5h-5"></path><path d="M21 12a9 9 0 0 1-15.3 6.4L3 16"></path><path d="M3 21v-5h5"></path></svg>
                          )}
                          {key === 'catch' && (
                            <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><path d="M8.5 8.5l7 7M15.5 8.5l-7 7"></path></svg>
                          )}
                          {key === 'forYou' && (
                            <svg viewBox="0 0 24 24" width="13" height="13"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2"></circle><circle cx="12" cy="12" r="3" fill="currentColor"></circle></svg>
                          )}
                        </span>
                        <span>{text}</span>
                      </dt>
                      <dd set:html={linkify(String(item[key as keyof typeof item] ?? ''))} />
                    </div>
                  ))}
                </dl>
              )}

              <ShareButtons
                title={heading}
                description={stripLinks(item.forYou || item.body || item.teaser || '')}
                url={`/daily/${dateStr}#story-${item.slot}`}
                compact
              />

              {sourcesOf(item).length > 0 && (
                <p class="brief__source">
                  <span class="brief__source-label">Sources</span>
                  {sourcesOf(item).map((s) => (
                    <a href={s.url} rel="noopener" target="_blank" class="brief__source-link">
                      {s.label || hostLabel(s.url)} &nearr;
                    </a>
                  ))}
                </p>
              )}
            </li>
          </>
        );
      })}
    </ol>

    <div class="prose" style="margin-top: var(--s7)"><Content /></div>

    <div class="brief-signoff">
      <svg width="28" height="28" viewBox="0 0 24 24" class="brief-signoff__mark" aria-hidden="true">
        <circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2"></circle>
        <circle cx="12" cy="12" r="3" fill="currentColor"></circle>
      </svg>
      <span class="brief-signoff__text">That's the five. Press and hold tomorrow.</span>
    </div>

    <div class="brief-share-end" style="margin-top: var(--s6); margin-bottom: var(--s6); padding-top: var(--s5); border-top: 1px solid var(--rule);">
      <ShareButtons
        title={d.title}
        description={d.description}
      />
    </div>

    <nav class="edition-nav" aria-label="Edition Navigation">
      <div class="edition-nav__col edition-nav__col--prev">
        {prevBrief ? (
          <a href={`/daily/${prevBrief.dateStr}`} class="edition-nav__link">
            <span class="edition-nav__sub">&larr; Previous Brief</span>
            <span class="edition-nav__title">{shortDate.format(prevBrief.date)}</span>
          </a>
        ) : (
          <span class="edition-nav__disabled">Beginning of archive</span>
        )}
      </div>

      <div class="edition-nav__col edition-nav__col--center">
        <a href="/daily" class="chip chip--secondary">All Issues ({totalCount})</a>
      </div>

      <div class="edition-nav__col edition-nav__col--next">
        {nextBrief ? (
          <a href={`/daily/${nextBrief.dateStr}`} class="edition-nav__link">
            <span class="edition-nav__sub">Next Brief &rarr;</span>
            <span class="edition-nav__title">{shortDate.format(nextBrief.date)}</span>
          </a>
        ) : (
          <span class="edition-nav__disabled">Latest edition</span>
        )}
      </div>
    </nav>
  </article>
  </div>

  <script is:inline>
    function scrollCurrentHashIntoView() {
      if (!window.location.hash) return;
      const rawId = window.location.hash.slice(1);
      const target = document.getElementById(rawId) ||
        document.getElementById(`story-${rawId}`) ||
        document.getElementById(`slot-${rawId}`);
      if (target) {
        setTimeout(() => {
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }, 60);
      }
    }
    if (document.readyState === 'complete') {
      scrollCurrentHashIntoView();
    } else {
      window.addEventListener('load', scrollCurrentHashIntoView);
    }
    window.addEventListener('hashchange', scrollCurrentHashIntoView);
  </script>
</BaseLayout>

<style>
  /* The roundup's social cards are 1080x1080. Full width would shout louder
     than the headline, so cap them and let the text lead. Width and height are
     on the tag itself, so the box is reserved before the file loads and the
     brief never reflows.
     NOTE: .brief__figure / .brief__card / .brief__caption rules live in
     global.css, not here -- ResponsiveImage renders the <figure> from its
     own .astro file, so a scoped rule for it in this file's <style> block
     never matches the rendered element. See global.css for the actual
     styling of these classes. */
</style>
