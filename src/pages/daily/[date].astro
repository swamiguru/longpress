---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ResponsiveImage from '../../components/ResponsiveImage.astro';
import AdSlot from '../../components/AdSlot.astro';
import PreviouslyOn from '../../components/PreviouslyOn.astro';
import WhatsAppCta from '../../components/WhatsAppCta.astro';
import ShareButtons from '../../components/ShareButtons.astro';
import PreferredSource from '../../components/PreferredSource.astro';
import PageCrumb from '../../components/PageCrumb.astro';
import { getArticleReadingTime } from '../../lib/readingTime';
import { getResponsiveImage } from '../../lib/images';
import { pickBriefLead } from '../../lib/seo/og.mjs';
import { fallbackFor } from '../../lib/fallbacks';
import '../../styles/daily-five.css';
import '../../styles/daily-editorial.css';
import { linkify, stripLinks, hostLabel } from '../../lib/text/inline.mjs';

/** Every link an item cites: the `sources` list plus the legacy single `source`, de-duplicated. */
function sourcesOf(item: { source?: string; sources?: { label?: string; url: string }[] }) {
  const all = [...(item.sources ?? []), ...(item.source ? [{ url: item.source }] : [])];
  const seen = new Set<string>();
  return all.filter((s) => !seen.has(s.url) && seen.add(s.url));
}

export async function getStaticPaths() {
  const briefs = await getCollection('daily', ({ data }) => !data.draft);
  briefs.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
  const total = briefs.length;
  return briefs.map((brief, idx) => ({
    params: { date: brief.id.replace(/\.md$/, '') },
    props: {
      brief,
      totalCount: total,
      prevBrief: briefs[idx + 1] ? {
        dateStr: briefs[idx + 1].id.replace(/\.md$/, ''),
        date: briefs[idx + 1].data.date,
      } : null,
      nextBrief: briefs[idx - 1] ? {
        dateStr: briefs[idx - 1].id.replace(/\.md$/, ''),
        date: briefs[idx - 1].data.date,
      } : null,
    },
  }));
}

const { brief, prevBrief, nextBrief, totalCount } = Astro.props;
const { Content } = await render(brief);
const d = brief.data;
const dateStr = brief.id.replace(/\.md$/, '');
const items = [...d.items].sort((a, b) => a.slot - b.slot);
const OPINION = ['commentary', 'hot-take', 'myth-buster', 'known-issue'];
const label = (k: string) => k.replace(/-/g, ' ');
const long = new Intl.DateTimeFormat('en-IN', { dateStyle: 'full' });
const shortDate = new Intl.DateTimeFormat('en-IN', { day: 'numeric', month: 'short' });
const short = new Intl.DateTimeFormat('en-IN', { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric' });
const readingTime = getArticleReadingTime(brief);
const taps = d.taps ?? [];
/** Briefs carry a date, not a time, so the head and strips show the date only. */
const heroDate = new Intl.DateTimeFormat('en-IN', { day: 'numeric', month: 'short' }).format(d.date);
const stripDate = new Intl.DateTimeFormat('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }).format(d.date);
const NUM_WORD = ['Zero', 'One', 'Two', 'Three', 'Four', 'Five'];
const countWord = NUM_WORD[items.length] ?? String(items.length);

/** Editorial tiers by position: a lead, two mid stories, two short ones. */
const tierOf = (i: number) => (i === 0 ? 'lead' : i <= 2 ? 'mid' : 'short');
const words = (t?: string) => (t ?? '').trim().split(/\s+/).filter(Boolean).length;
const readMin = (it: any) => Math.max(1, Math.round((words(it.body ?? it.teaser) + words(it.problem) + words(it.catch) + words(it.forYou)) / 220));

/** The press-and-hold structure, in reading order. */
/** Share image for the whole brief, and its alt text. */
const leadImage = pickBriefLead(dateStr) ?? undefined;
const leadSlot = leadImage?.match(/\/(?:illustration|card)_(\d+)\./)?.[1];
const leadItem = leadSlot ? items.find((i) => String(i.slot) === leadSlot) : undefined;
const leadAlt = leadImage?.startsWith('/images/daily-cards/')
  ? `Headline card: ${d.title}`
  : leadItem ? leadItem.imageAlt || `Illustration for the story: ${leadItem.heading}` : undefined;

const ANALYSIS = [
  ['problem', 'The problem'],
  ['breakthrough', 'What changed'],
  ['catch', 'The catch'],
  ['forYou', 'What it means for you'],
] as const;
---
<BaseLayout title={d.title} seoTitle={d.seoTitle} description={d.description} schema="NewsArticle" published={d.date} image={leadImage} imageAlt={leadAlt} wide>
  <div class="pg pg--daily pg--article">
  <article>
    <PageCrumb label="The Daily Five" href="/daily" />

    <header class="ph ph--story ph--brief">
      <div class="ph__body">
        <div class="df-clock">
          <span class="df-clock__time">{heroDate}</span>
          <span class="df-clock__meta">
            <b>The Daily Five</b>
            <span>{new Intl.DateTimeFormat('en-IN', { weekday: 'long' }).format(d.date)}</span>
          </span>
        </div>
        <h1 class="ph__title">{d.title}</h1>
        {d.intro && <p class="ph__stand">{d.intro}</p>}
        <div class="byline">
          <span class="byline__mark"><svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2"></circle><circle cx="12" cy="12" r="2.6" fill="currentColor"></circle></svg></span>
          <span class="byline__who">
            <strong class="byline__name">Long Press</strong>
            <span class="byline__date">Published by {d.author} &middot; <time datetime={d.date.toISOString()}>{short.format(d.date)}</time></span>
          </span>
          <span class="byline__read">{readingTime.text}</span>
        </div>
        <ShareButtons title={d.title} description={d.description} compact class="share-bar--top">
          <PreferredSource />
        </ShareButtons>
      </div>
    </header>

    <WhatsAppCta variant="strip" location="brief_top" />

    <div class="ed">
      <nav class="ed-nav" id="ed-nav" aria-label="In this issue">
        <p class="ed-nav__label">In this issue</p>
        <ol class="ed-nav__list">
          {items.map((item) => (
            <li>
              <a class="ed-nav__link" href={`#story-${item.slot}`} data-target={`story-${item.slot}`}>
                <span class="ed-nav__n">{item.slot}</span><span class="ed-nav__t">{item.heading}</span>
              </a>
            </li>
          ))}
          {taps.length > 0 && (
            <li>
              <a class="ed-nav__link" href="#taps" data-target="taps">
                <span class="ed-nav__n">+</span><span class="ed-nav__t">Taps</span>
              </a>
            </li>
          )}
        </ol>
        <span class="ed-nav__bar" aria-hidden="true"></span>
      </nav>

      <div class="ed-main">
        {items.map((item, i) => {
          const tier = tierOf(i);
          const next = items[i + 1];
          const nextHref = next ? `#story-${next.slot}` : taps.length ? '#taps' : null;
          const nextLabel = next ? next.heading : 'Taps';
          const heading = item.heading;
          const cites = sourcesOf(item);
          const img = tier === 'lead'
            ? getResponsiveImage(item.image ?? fallbackFor(item.kind, d.date), { aspectRatio: '1/1', customSizes: '(max-width: 759px) 100vw, 700px' })
            : null;
          return (
            <>
              {i === 2 && <div class="ed-ad"><AdSlot placement="brief" /></div>}
              <section id={`story-${item.slot}`} class={`ed-story ed-story--${tier}`} aria-labelledby={`ed-h-${item.slot}`}>
                <span id={`slot-${item.slot}`} class="slot-anchor" aria-hidden="true"></span>
                <span id={heading.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '')} class="slot-anchor" aria-hidden="true"></span>
                <p class="ed-kicker">
                  <b>{label(item.kind)}</b>
                  {item.region === 'india' && <span>India</span>}
                </p>
                <h2 class="ed-title" id={`ed-h-${item.slot}`}>{heading}</h2>
                {img && (
                  <figure class="ed-fig">
                    <img src={img.src} srcset={img.srcset} sizes={img.sizes} width={img.width} height={img.height}
                      alt={item.imageAlt || `Illustration for the story: ${heading}`} loading="eager" decoding="async" />
                  </figure>
                )}
                <div class="ed-body">
                  {item.body && <p set:html={linkify(item.body)} />}
                  {item.story && (
                    <>
                      <p set:html={linkify(item.teaser)} />
                      <p class="df-story__more"><a href={`/${item.story}`}>Read the full story &rarr;</a></p>
                    </>
                  )}
                </div>
                {tier === 'lead' && item.problem && (
                  <p class="ed-plain"><strong class="ed-run">The problem.</strong> <span set:html={linkify(item.problem)} /></p>
                )}
                {item.catch && (
                  <p class="ed-catch"><span class="ed-lead-in">The catch</span><span set:html={linkify(item.catch)} /></p>
                )}
                {item.forYou && (
                  <p class="ed-close"><strong class="ed-run">What it means for you.</strong> <span set:html={linkify(item.forYou)} /></p>
                )}
                {tier === 'lead' && item.qa && item.qa.length > 0 && (
                  <section class="ed-qa" aria-label={`Questions about: ${heading}`}>
                    <h3 class="ed-qa__h">Questions people ask</h3>
                    <dl>
                      {item.qa.map((x) => (<><dt>{x.q}</dt><dd>{x.a}</dd></>))}
                    </dl>
                  </section>
                )}
                <div class="ed-foot">
                  {cites.length > 0 ? (
                    <p class="df-source">
                      <span class="df-source__label">Sources</span>
                      {cites.map((s) => (<a href={s.url} rel="noopener" target="_blank">{s.label || hostLabel(s.url)} &nearr;</a>))}
                    </p>
                  ) : <span></span>}
                  <ShareButtons
                    title={heading}
                    description={stripLinks(item.answer || item.forYou || item.body || item.teaser || '')}
                    url={item.story ? `/${item.story}` : `/daily/${dateStr}/${item.slot}`}
                    compact
                  />
                </div>
                <div class="df-prev"><PreviouslyOn id={`daily:${dateStr}#${item.slot}`} /></div>
                {nextHref && (
                  <a class="ed-next" href={nextHref}>
                    <span class="ed-next__k">Next</span>
                    <span class="ed-next__t">{nextLabel}</span>
                    <span aria-hidden="true">&darr;</span>
                  </a>
                )}
              </section>
            </>
          );
        })}

        {taps.length > 0 && (
          <section class="taps" id="taps" aria-labelledby="taps-title">
            <div class="taps__head">
              <h2 class="taps__title" id="taps-title">Taps</h2>
              <p class="taps__sub">Quick hits. One line each, for when a long press is too much.</p>
            </div>
            <ul class="taps__list">
              {taps.map((t) => (
                <li class="tap">
                  {t.region && <span class={`tap__region tap__region--${t.region}`}>{t.region === 'india' ? 'India' : 'Global'}</span>}
                  <div class="tap__text">
                    <p class="tap__headline">{t.headline}</p>
                    {t.line && <p class="tap__line" set:html={linkify(t.line)} />}
                  </div>
                  {t.source && (
                    <a class="tap__source" href={t.source.url} rel="noopener" target="_blank">
                      {t.source.label || hostLabel(t.source.url)} &nearr;
                    </a>
                  )}
                </li>
              ))}
            </ul>
          </section>
        )}
      </div>
    </div>

    <div class="prose" style="margin-top: var(--s7)"><Content /></div>

    <div class="df-cap">
      <svg width="28" height="28" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2"></circle><circle cx="12" cy="12" r="3" fill="currentColor"></circle></svg>
      <span>That's {items.length === 5 ? 'all five' : `all ${countWord.toLowerCase()}`}. Next edition tomorrow.</span>
      <small>Press and hold</small>
    </div>

    <WhatsAppCta variant="card" location="brief_end" />

    <div class="brief-share-end" style="margin-top: var(--s6); margin-bottom: var(--s6); padding-top: var(--s5); border-top: 1px solid var(--rule);">
      <ShareButtons
        title={d.title}
        description={d.description}
      />
    </div>

    <nav class="edition-nav" aria-label="Edition Navigation">
      <div class="edition-nav__col edition-nav__col--prev">
        {prevBrief ? (
          <a href={`/daily/${prevBrief.dateStr}`} class="edition-nav__link">
            <span class="edition-nav__sub">&larr; Previous Brief</span>
            <span class="edition-nav__title">{shortDate.format(prevBrief.date)}</span>
          </a>
        ) : (
          <span class="edition-nav__disabled">Beginning of archive</span>
        )}
      </div>

      <div class="edition-nav__col edition-nav__col--center">
        <a href="/daily" class="chip chip--secondary">All Issues ({totalCount})</a>
      </div>

      <div class="edition-nav__col edition-nav__col--next">
        {nextBrief ? (
          <a href={`/daily/${nextBrief.dateStr}`} class="edition-nav__link">
            <span class="edition-nav__sub">Next Brief &rarr;</span>
            <span class="edition-nav__title">{shortDate.format(nextBrief.date)}</span>
          </a>
        ) : (
          <span class="edition-nav__disabled">Latest edition</span>
        )}
      </div>
    </nav>
  </article>
  </div>

  <script is:inline>
    function scrollCurrentHashIntoView() {
      if (!window.location.hash) return;
      const rawId = window.location.hash.slice(1);
      const target = document.getElementById(rawId) ||
        document.getElementById(`story-${rawId}`) ||
        document.getElementById(`slot-${rawId}`);
      if (target) {
        setTimeout(() => {
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }, 60);
      }
    }
    if (document.readyState === 'complete') {
      scrollCurrentHashIntoView();
    } else {
      window.addEventListener('load', scrollCurrentHashIntoView);
    }
    window.addEventListener('hashchange', scrollCurrentHashIntoView);
  </script>
  <script is:inline>
    (function () {
      var nav = document.getElementById('ed-nav');
      if (!nav) return;
      var root = document.documentElement;
      var wrap = nav.parentElement;
      var list = nav.querySelector('.ed-nav__list');
      var links = [].slice.call(nav.querySelectorAll('.ed-nav__link'));
      var targets = links.map(function (a) { return document.getElementById(a.getAttribute('data-target')); });
      var mast = document.querySelector('.masthead');
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var current = null;
      function setTop() {
        var h = 0;
        if (mast && getComputedStyle(mast).position === 'sticky') h = mast.getBoundingClientRect().height;
        root.style.setProperty('--ed-top', h + 'px');
      }
      function setActive(i) {
        if (i === current) return;
        current = i;
        links.forEach(function (a, n) {
          if (n === i) a.setAttribute('aria-current', 'true'); else a.removeAttribute('aria-current');
        });
        if (window.innerWidth < 1100 && links[i]) {
          list.scrollTo({ left: Math.max(0, links[i].parentElement.offsetLeft - 16), behavior: reduce ? 'auto' : 'smooth' });
        }
      }
      var ticking = false;
      function update() {
        ticking = false;
        var top = parseFloat(getComputedStyle(root).getPropertyValue('--ed-top')) || 0;
        var line = top + (window.innerWidth < 1100 ? nav.offsetHeight : 0) + 32;
        var idx = 0;
        targets.forEach(function (t, n) { if (t && t.getBoundingClientRect().top <= line) idx = n; });
        setActive(idx);
        var r = wrap.getBoundingClientRect();
        var span = r.height - window.innerHeight;
        var p = span > 0 ? Math.min(1, Math.max(0, -r.top / span)) : 0;
        nav.style.setProperty('--p', p.toFixed(3));
      }
      function onScroll() { if (!ticking) { ticking = true; requestAnimationFrame(update); } }
      setTop();
      update();
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', function () { setTop(); onScroll(); });
    })();
  </script>
</BaseLayout>

<style>
  /* The roundup's social cards are 1080x1080. Full width would shout louder
     than the headline, so cap them and let the text lead. Width and height are
     on the tag itself, so the box is reserved before the file loads and the
     brief never reflows.
     NOTE: .brief__figure / .brief__card / .brief__caption rules live in
     global.css, not here -- ResponsiveImage renders the <figure> from its
     own .astro file, so a scoped rule for it in this file's <style> block
     never matches the rendered element. See global.css for the actual
     styling of these classes. */
</style>
