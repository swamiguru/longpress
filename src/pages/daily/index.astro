---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdSlot from '../../components/AdSlot.astro';
import { getArticleReadingTime } from '../../lib/readingTime';

const briefs = (await getCollection('daily', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

interface MonthGroup {
  id: string; // e.g. "2026-09"
  fullName: string; // e.g. "September 2026"
  shortName: string; // e.g. "Sep 2026"
  year: number;
  monthNum: string;
  briefs: typeof briefs;
}

const monthGroups: MonthGroup[] = [];
const groupMap = new Map<string, MonthGroup>();

for (const b of briefs) {
  const d = b.data.date;
  const year = d.getFullYear();
  const monthIdx = d.getMonth();
  const monthNum = String(monthIdx + 1).padStart(2, '0');
  const id = `${year}-${monthNum}`;

  if (!groupMap.has(id)) {
    const fullName = new Intl.DateTimeFormat('en-IN', { month: 'long', year: 'numeric' }).format(d);
    const shortName = new Intl.DateTimeFormat('en-IN', { month: 'short', year: 'numeric' }).format(d);
    const group: MonthGroup = { id, fullName, shortName, year, monthNum, briefs: [] };
    groupMap.set(id, group);
    monthGroups.push(group);
  }
  groupMap.get(id)!.briefs.push(b);
}

const med = new Intl.DateTimeFormat('en-IN', { dateStyle: 'medium' });
---
<BaseLayout
  title="The Daily Five - archive"
  description="Every Long Press morning brief, newest first. Five tech stories a day, with an honest take."
  wide
>
  <!-- Month Pagination Bar (Top) -->
  <div class="page-head" id="archive-head">
    <span class="eyebrow">Daily Archive &middot; 10:00 IST</span>
    <h1>The Daily Five</h1>
    <p class="standfirst" id="archive-standfirst">
      Published every morning since 12 July 2026. {briefs.length} issues paginated by monthly volumes.
    </p>

    <!-- Interactive month pagination bar -->
    <nav class="archive-pagination-bar" aria-label="Month pagination" id="archive-pagination-bar">
      <button
        type="button"
        class="archive-nav-btn"
        id="btn-older-month-top"
        aria-label="Go to older month"
      >
        <span aria-hidden="true">&larr;</span>
        <span id="label-older-month">Older Month</span>
      </button>

      <div class="archive-filter-pills" role="tablist" id="month-pills-container">
        {monthGroups.map((g, idx) => (
          <button
            type="button"
            class={`archive-filter-btn ${idx === 0 ? 'is-active' : ''}`}
            data-month-target={g.id}
            data-month-index={idx}
            role="tab"
            aria-selected={idx === 0 ? 'true' : 'false'}
            id={`tab-month-${g.id}`}
          >
            <span>{g.shortName}</span>
            <span class="badge-count">{g.briefs.length}</span>
          </button>
        ))}
        <button
          type="button"
          class="archive-filter-btn"
          data-month-target="all"
          role="tab"
          aria-selected="false"
          id="tab-all-months"
        >
          <span>All ({briefs.length})</span>
        </button>
      </div>

      <button
        type="button"
        class="archive-nav-btn"
        id="btn-newer-month-top"
        aria-label="Go to newer month"
        disabled
      >
        <span id="label-newer-month">Newer Month</span>
        <span aria-hidden="true">&rarr;</span>
      </button>
    </nav>
  </div>

  <!-- Monthly Stacked & Paginated Sections -->
  <div class="archive-stacks" id="archive-stacks">
    {monthGroups.map((group, groupIndex) => {
      // By default only the latest month (groupIndex === 0) is rendered unhidden!
      const isInitiallyVisible = groupIndex === 0;
      const prevMonth = monthGroups[groupIndex + 1]; // older
      const nextMonth = monthGroups[groupIndex - 1]; // newer
      return (
        <section
          class="archive-month-block"
          id={`month-${group.id}`}
          data-month-id={group.id}
          data-month-index={groupIndex}
          aria-labelledby={`heading-${group.id}`}
          hidden={!isInitiallyVisible}
        >
          <div class="archive-month-header">
            <div class="archive-month-title-group">
              <h2 class="archive-month-title" id={`heading-${group.id}`}>
                {group.fullName}
              </h2>
              <span class="archive-month-badge">
                {group.briefs.length} {group.briefs.length === 1 ? 'issue' : 'issues'}
              </span>
              <span class="pill-tag pill-tag--muted" style="font-size: 10px;">
                Volume {monthGroups.length - groupIndex} of {monthGroups.length}
              </span>
            </div>
            <a href="#archive-head" class="archive-jump-top" aria-label={`Back to top from ${group.fullName}`}>
              <span>Top &uarr;</span>
            </a>
          </div>

          <ul class="entries">
            {group.briefs.map((b, i) => {
              const dateSlug = b.id.replace(/\.md$/, '');
              const dayOfWeek = new Intl.DateTimeFormat('en-IN', { weekday: 'short' }).format(b.data.date);
              return (
                <>
                  {group.id === monthGroups[0]?.id && i === 6 && (
                    <li class="ad-row"><AdSlot placement="hub" /></li>
                  )}
                  <li id={`brief-${dateSlug}`}>
                    <div class="entry__meta-row">
                      <div style="display: flex; align-items: center; gap: 8px;">
                        <time class="dateline entry__meta" datetime={b.data.date.toISOString()}>
                          {med.format(b.data.date)}
                        </time>
                        <span class="pill-tag pill-tag--muted" style="font-size: 9.5px; padding: 2px 7px;">
                          {dayOfWeek}
                        </span>
                      </div>
                      <span class="entry__reading-time">{getArticleReadingTime(b).text}</span>
                    </div>
                    <h3 class="entry__title">
                      <a href={`/daily/${dateSlug}`}>{b.data.title}</a>
                    </h3>
                    <p class="entry__desc">{b.data.description}</p>
                    <div class="entry__footer">
                      <span class="entry__meta-note">5 Stories</span>
                      <div class="entry__actions">
                        <button
                          type="button"
                          class="card-share-btn"
                          data-share-title={`${b.data.title} — Long Press Daily Five`}
                          data-share-url={`/daily/${dateSlug}`}
                          data-share-desc={b.data.description}
                          aria-label={`Share ${b.data.title}`}
                          title="Share brief via Web Share API"
                        >
                          <svg class="card-share-btn__icon card-share-btn__icon--share" viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <circle cx="18" cy="5" r="3"></circle>
                            <circle cx="6" cy="12" r="3"></circle>
                            <circle cx="18" cy="19" r="3"></circle>
                            <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
                            <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
                          </svg>
                          <svg class="card-share-btn__icon card-share-btn__icon--check" viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M20 6L9 17l-5-5"></path>
                          </svg>
                          <span class="card-share-btn__text">Share</span>
                        </button>
                        <a href={`/daily/${dateSlug}`} class="entry__cta" aria-label={`Read brief from ${med.format(b.data.date)}`}>
                          Read Issue &rarr;
                        </a>
                      </div>
                    </div>
                  </li>
                </>
              );
            })}
          </ul>

          <!-- Bottom Month Pagination -->
          <div class="archive-pagination-bottom">
            <div>
              {prevMonth ? (
                <button
                  type="button"
                  class="archive-nav-btn archive-bottom-nav"
                  data-nav-target={prevMonth.id}
                  aria-label={`Go to ${prevMonth.fullName}`}
                >
                  <span aria-hidden="true">&larr;</span>
                  <span>{prevMonth.fullName} ({prevMonth.briefs.length})</span>
                </button>
              ) : (
                <span class="archive-pagination-info" style="color: var(--muted); font-size: 10px;">
                  Earliest Archive Volume
                </span>
              )}
            </div>

            <div class="archive-pagination-info">
              {group.fullName} &middot; Volume {monthGroups.length - groupIndex} of {monthGroups.length}
            </div>

            <div>
              {nextMonth ? (
                <button
                  type="button"
                  class="archive-nav-btn archive-bottom-nav"
                  data-nav-target={nextMonth.id}
                  aria-label={`Go to ${nextMonth.fullName}`}
                >
                  <span>{nextMonth.fullName} ({nextMonth.briefs.length})</span>
                  <span aria-hidden="true">&rarr;</span>
                </button>
              ) : (
                <span class="archive-pagination-info" style="color: var(--muted); font-size: 10px;">
                  Latest Archive Volume
                </span>
              )}
            </div>
          </div>
        </section>
      );
    })}
  </div>

  <script>
    function setupArchivePagination() {
      const paginationBar = document.getElementById('archive-pagination-bar');
      if (!paginationBar) return;

      const pills = paginationBar.querySelectorAll<HTMLButtonElement>('.archive-filter-btn');
      const btnOlder = document.getElementById('btn-older-month-top') as HTMLButtonElement | null;
      const btnNewer = document.getElementById('btn-newer-month-top') as HTMLButtonElement | null;
      const labelOlder = document.getElementById('label-older-month');
      const labelNewer = document.getElementById('label-newer-month');
      const monthSections = Array.from(document.querySelectorAll<HTMLElement>('.archive-month-block'));
      const bottomNavButtons = document.querySelectorAll<HTMLButtonElement>('.archive-bottom-nav');

      const monthIds = monthSections.map((s) => s.getAttribute('data-month-id') || '');
      let currentIndex = 0; // 0 is newest month (September 2026)
      let isAllMode = false;

      function updateUI(scrollIntoView = false) {
        // Update pills
        pills.forEach((pill) => {
          const target = pill.getAttribute('data-month-target');
          const isActive = isAllMode ? target === 'all' : target === monthIds[currentIndex];
          pill.classList.toggle('is-active', isActive);
          pill.setAttribute('aria-selected', isActive ? 'true' : 'false');
        });

        // Show/hide sections
        monthSections.forEach((section, idx) => {
          if (isAllMode) {
            section.removeAttribute('hidden');
          } else if (idx === currentIndex) {
            section.removeAttribute('hidden');
          } else {
            section.setAttribute('hidden', '');
          }
        });

        // Update Prev/Next top buttons
        if (isAllMode) {
          if (btnOlder) {
            btnOlder.disabled = true;
            if (labelOlder) labelOlder.textContent = 'Older Month';
          }
          if (btnNewer) {
            btnNewer.disabled = true;
            if (labelNewer) labelNewer.textContent = 'Newer Month';
          }
        } else {
          // Older month is currentIndex + 1
          if (btnOlder) {
            const hasOlder = currentIndex < monthIds.length - 1;
            btnOlder.disabled = !hasOlder;
            if (labelOlder) {
              const olderSection = monthSections[currentIndex + 1];
              const olderTitle = olderSection ? olderSection.querySelector('.archive-month-title')?.textContent?.trim() : '';
              labelOlder.textContent = olderTitle ? `← ${olderTitle}` : 'Older Month';
            }
          }

          // Newer month is currentIndex - 1
          if (btnNewer) {
            const hasNewer = currentIndex > 0;
            btnNewer.disabled = !hasNewer;
            if (labelNewer) {
              const newerSection = monthSections[currentIndex - 1];
              const newerTitle = newerSection ? newerSection.querySelector('.archive-month-title')?.textContent?.trim() : '';
              labelNewer.textContent = newerTitle ? `${newerTitle} →` : 'Newer Month';
            }
          }
        }

        // Update hash in URL
        const newHash = isAllMode ? 'all' : monthIds[currentIndex];
        if (newHash) {
          history.replaceState(null, '', `#${newHash}`);
        }

        if (scrollIntoView) {
          const stacksEl = document.getElementById('archive-stacks');
          if (stacksEl) {
            stacksEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        }
      }

      // Pill clicks
      pills.forEach((pill) => {
        pill.addEventListener('click', () => {
          const target = pill.getAttribute('data-month-target');
          if (target === 'all') {
            isAllMode = true;
          } else {
            isAllMode = false;
            const idx = monthIds.indexOf(target || '');
            if (idx !== -1) currentIndex = idx;
          }
          updateUI(true);
        });
      });

      // Older top button click
      btnOlder?.addEventListener('click', () => {
        if (currentIndex < monthIds.length - 1) {
          currentIndex += 1;
          isAllMode = false;
          updateUI(true);
        }
      });

      // Newer top button click
      btnNewer?.addEventListener('click', () => {
        if (currentIndex > 0) {
          currentIndex -= 1;
          isAllMode = false;
          updateUI(true);
        }
      });

      // Bottom nav button clicks
      bottomNavButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const target = btn.getAttribute('data-nav-target');
          const idx = monthIds.indexOf(target || '');
          if (idx !== -1) {
            currentIndex = idx;
            isAllMode = false;
            updateUI(true);
          }
        });
      });

      // Initial hash detection on load
      const hash = window.location.hash.replace(/^#(month-)?/, '');
      if (hash === 'all') {
        isAllMode = true;
      } else if (hash && monthIds.includes(hash)) {
        currentIndex = monthIds.indexOf(hash);
        isAllMode = false;
      }

      updateUI(false);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupArchivePagination);
    } else {
      setupArchivePagination();
    }
  </script>
</BaseLayout>
